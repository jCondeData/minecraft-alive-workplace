			x: 6.0d,
			y: 11.0d,
			title: "The Lumberjack: a Fletcher's Lodge",
			description: ["The Lumberjack has no table of their own: they work at a Fletching Table. Build the Fletcher's Lodge, a log cabin with a fletching table, and sneak-right-click a villager by it holding an axe.", "", "They fell whole trees, leaves and all, and plant a sapling where each one stood. Flint there makes a Fletcher instead."],
			dependencies: ["1F6C818E31AC5BC3"],
			icon: {id: "minecraft:iron_axe", count: 1},
