	order_index: 104,
	filename: "aliveworkplace_story_5_city",
	title: "5. A City",
	subtitle: ["Classes and grand homes, colonies and the realm"],
	icon: {id: "aliveworkplace:noble_robes", count: 1},
	default_quest_shape: "",
	default_hide_dependency_lines: false,
	quests: [
		{
			id: "5494189D8D643C66",
			x: 0.0d,
			y: 0.0d,
			title: "A City",
			description: ["Grow your Town into a City: 35 villagers, 25 finished buildings and 7 levels of research.", "", "1. Open the Village Hall (right-click it) and hover over the name tag at the top left: the yellow line says what the next rank still needs.", "2. Keep building homes and workplaces, and keep the scholars researching.", "", "A City is the top rank: its quests pay the most and it can grow the biggest.", "", "This quest completes by itself when it happens, for the hall's owner and for anyone within 64 blocks of the hall."],
			dependencies: ["39CFFC8EF5B3511D"],
			icon: {id: "aliveworkplace:village_hall", count: 1},
			tasks: [{id: "4DDC5F8BD69594AA", type: "advancement", advancement: "aliveworkplace:village/rank_city", criterion: ""}],
			rewards: [{id: "2B8E19C20A717B76", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 32}, {id: "4C78BFA60C569FC7", type: "xp", xp: 500}]
		},
		{
			id: "12115CCC90A3CBE2",
			x: 3.0d,
			y: 0.0d,
			title: "A grand home: Stone House III",
			description: ["Upgrade a Stone House II with a stone wing: two more beds, five in all.", "", "The Stone House II quest's reward put Stone House III in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick Stone House III and press Get Blueprint (it uses one Blank Blueprint).", "2. Right-click the finished Stone House II with it, without sneaking. The outline lines up exactly over the building.", "3. Hold Shift over the blueprint to see what it needs, and put it in chests within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with it. They only build what's new.", "", "A bed in a tier III building is a grand home, the happiest there is.", "", "This quest completes by itself when the builder finishes the Stone House III."],
			dependencies: ["5494189D8D643C66"],
			icon: {id: "minecraft:stone_bricks", count: 1},
			tasks: [{id: "158990E95DE3AEBC", type: "advancement", advancement: "aliveworkplace:built/stone_house_3", criterion: ""}],
			rewards: [{id: "183EB48A7857A074", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 5}]
		},
		{
			id: "2111E4C5203EC081",
			x: 6.0d,
			y: 0.0d,
			title: "The Classes tab",
			description: ["See how your villagers live: Peasants, Artisans, Burghers and Nobles.", "", "Open the Village Hall and click the golden helmet (Classes) in the row of page buttons. It counts the households of each class and shows what each needs to rise.", "", "Higher classes pay more tax, and some jobs need them.", "", "Click the checkmark above once you've opened the Classes tab."],
			dependencies: ["12115CCC90A3CBE2"],
			icon: {id: "minecraft:name_tag", count: 1},
			tasks: [{id: "346C6645C880D319", type: "checkmark", title: "I opened the Classes tab"}],
			rewards: [{id: "1D944FE4FBC59350", type: "xp", xp: 50}]
		},
		{
			id: "13BCA5AD7D9D18F4",
			x: 9.0d,
			y: 0.0d,
			title: "Burghers",
			description: ["Raise a household to Burgher.", "", "1. On the Classes tab, click Burgher to see what they need: among other things a tier II home, a varied diet, a school, a Market Square, Fine Clothes, Berry Wine and the Gazette.", "2. Give a household all of it two dawns running and it rises.", "3. The luxuries come from the Vintner, the Tailor and the Printer (side quests).", "", "Burghers pay more tax, and your builders then sell the Manor.", "", "Click the checkmark above once a household in your village is Burghers."],
			dependencies: ["2111E4C5203EC081"],
			tasks: [{id: "65D26DE32287122F", type: "checkmark", title: "A household in my village rose to Burgher"}],
			rewards: [{id: "1717707CEE51E2E6", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}, {id: "5ED089CBED84FFAA", type: "command", command: "/workplace unlock {p} aliveworkplace:manor", elevate_perms: true, silent: true}]
		},
		{
			id: "65D2BD1D26DB49AE",
			x: 12.0d,
			y: 0.0d,
			title: "The Manor",
			description: ["Build the Manor: three beds, a grand home from its first tier.", "", "The reward of the last quest (Burghers) put it in your Blueprint Table, and your builders also sell it for 20 emeralds once a household is Burghers.", "", "1. Right-click the Blueprint Table, pick the Manor and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "", "Nobles need a grand home like this one.", "", "This quest completes by itself when the builder finishes the Manor."],
			dependencies: ["13BCA5AD7D9D18F4"],
			icon: {id: "minecraft:dark_oak_door", count: 1},
			tasks: [{id: "18453C047CCAF64C", type: "advancement", advancement: "aliveworkplace:built/manor", criterion: ""}],
			rewards: [{id: "1909336BC9BD6EC7", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 6}]
		},
		{
			id: "1E0D668D5B1E3041",
			x: 15.0d,
			y: 0.0d,
			title: "Nobles",
			description: ["Raise a household all the way to Noble.", "", "1. On the Classes tab, click Noble to see what they need: among other things a tier III home, Noble Robes, Vintage Wine and an Emerald Brooch.", "2. Journeyman Tailors make Noble Robes and Journeyman Vintners Vintage Wine; Apprentice Jewelers make the Emerald Brooch.", "3. Give a Burgher household all of it two dawns running and it rises.", "", "Nobles pay four times the tax and make the whole village happier.", "", "Click the checkmark above once a household in your village is Nobles."],
			dependencies: ["65D2BD1D26DB49AE"],
			icon: {id: "aliveworkplace:noble_robes", count: 1},
			tasks: [{id: "6D4055538520C47C", type: "checkmark", title: "A household in my village rose to Noble"}],
			rewards: [{id: "192D5F8502D1A4A5", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 16}, {id: "7406F2B63046E70F", type: "xp", xp: 300}]
		},
		{
			id: "4B5E6D68C7EDDF14",
			x: 18.0d,
			y: 0.0d,
			title: "Found a realm",
			description: ["Found a realm with your village as its capital.", "", "1. Open the Village Hall of a Town or City and click the minecart (Trade routes) in the second row.", "2. Click the Realm tab, then Found a realm.", "", "A realm starts as a Barony. Its villages share a treasury and research, and send riders when one is raided.", "", "Click the checkmark above once you've founded a realm."],
			dependencies: ["1E0D668D5B1E3041"],
			icon: {id: "minecraft:filled_map", count: 1},
			tasks: [{id: "76E935D5FF22E65B", type: "checkmark", title: "I founded a realm"}],
			rewards: [{id: "2A41066C700B43AA", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}]
		},
		{
			id: "339CBA70CF3E3588",
			x: 21.0d,
			y: 0.0d,
			title: "The Colony Charter",
			description: ["Buy a Colony Charter to send settlers out to found a new village.", "", "1. Open a City's Village Hall, click the minecart (Trade routes), then the Colonies tab.", "2. Buy a Colony Charter for 32 emeralds: the treasury pays what it can and you pay the rest.", "3. Choose the spot on the charter's map, or by standing there.", "", "A colony is a new village of your own, with a road home.", "", "This quest completes by itself as soon as you have a Colony Charter in your inventory."],
			dependencies: ["4B5E6D68C7EDDF14"],
			icon: {id: "aliveworkplace:colony_charter", count: 1},
			tasks: [{id: "663318F40B5AE5B4", type: "item", item: {id: "aliveworkplace:colony_charter", count: 1}}],
			rewards: [{id: "44CDF255F09638EE", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}]
		},
		{
			id: "4859C324A06258BE",
			x: 24.0d,
			y: 0.0d,
			title: "A colony",
			description: ["Found your first colony.", "", "1. Right-click your Village Hall with the Colony Charter. Two settlers volunteer, one of them a builder.", "2. They pack logs, planks, cobblestone, bread, torches, glass panes and beds from the Storehouse chests. Anything missing goes on the Storehouse's requests, so fill it.", "3. The morning they leave, they walk to the spot and make camp, with the colony's own Village Hall.", "", "The colony is yours and joins your realm; you get a letter when they arrive.", "", "This quest completes by itself when the colony is founded, for the hall's owner and for anyone within 64 blocks of your hall."],
			dependencies: ["339CBA70CF3E3588"],
			tasks: [{id: "16D630EED86F0460", type: "advancement", advancement: "aliveworkplace:village/colony", criterion: ""}],
			rewards: [{id: "1FAD1C9448ED3076", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 12}]
		},
		{
			id: "21096BAB5BF0E03B",
			x: 27.0d,
			y: 0.0d,
			shape: "gear",
			size: 1.5d,
			title: "A Kingdom",
			description: ["Grow your realm into a Kingdom.", "", "1. At the capital, open the Realm tab (minecart, then Realm) and add villages: your own and your friends' join with a click, other players' by invitation.", "2. A Kingdom needs 8 villages, with the capital and one more of them Cities.", "", "A realm rises from Barony to County, Duchy and Kingdom, up to 12 villages.", "", "Click the checkmark above once the Realm tab says your realm is a Kingdom."],
			dependencies: ["4859C324A06258BE"],
			icon: {id: "minecraft:golden_helmet", count: 1},
			tasks: [{id: "1B1862547084F201", type: "checkmark", title: "My realm is a Kingdom"}],
			rewards: [{id: "5107DFF36A6041D8", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 32}, {id: "6F24968D20727A27", type: "xp", xp: 500}]
		},
		{
			id: "787D3A28E1654FED",
			x: 0.0d,
			y: -2.0d,
			optional: true,
			title: "A Pokémon Center",
			description: ["Build a Pokémon Center: a Healing Machine and two PCs under one roof.", "", "1. Right-click the Blueprint Table, pick the Pokémon Center and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "", "Its tier II adds beds and a Shop Counter.", "", "This quest completes by itself when the builder finishes the Pokémon Center."],
			dependencies: ["5494189D8D643C66"],
			icon: {id: "cobblemon:healing_machine", count: 1},
			tasks: [{id: "74E97CFC98BB8AF0", type: "advancement", advancement: "aliveworkplace:built/pokemon_center", criterion: ""}],
			rewards: [{id: "45A5AEDA299CAA14", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "78CA45B0A4A07675",
			x: 3.0d,
			y: -2.0d,
			optional: true,
			title: "Starter Cottage III",
			description: ["Give your cottage its last tier: a kitchen wing with a smoker, and a roof terrace.", "", "The Starter Cottage II quest's reward put Starter Cottage III in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick Starter Cottage III and press Get Blueprint (it uses one Blank Blueprint).", "2. Right-click the finished Starter Cottage II with it, without sneaking. The outline lines up exactly over the building.", "3. Hold Shift over the blueprint to see what it needs, and put it in chests within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with it. They only build what's new.", "", "Its beds count as grand homes.", "", "This quest completes by itself when the builder finishes the Starter Cottage III."],
			dependencies: ["12115CCC90A3CBE2"],
			tasks: [{id: "1EBFB3F0A560FB7A", type: "advancement", advancement: "aliveworkplace:built/starter_cottage_3", criterion: ""}],
			rewards: [{id: "352F6417E13A8E71", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "15B6054CC78C92FF",
			x: 3.0d,
			y: 2.0d,
			optional: true,
			title: "Library III",
			description: ["Give your Library its last tier: an enchanting room with a third lectern.", "", "1. The builder who finished your Library II now sells the Library III blueprint. Right-click them to trade for it.", "2. Right-click the finished Library II with it, without sneaking. The outline lines up exactly over the building.", "3. Hold Shift over the blueprint to see what it needs, and put it in chests within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with it. They only build what's new.", "", "The enchanting table is ringed by fifteen bookshelves.", "", "This quest completes by itself when the builder finishes the Library III."],
			dependencies: ["12115CCC90A3CBE2"],
			tasks: [{id: "1884567B9FFF4C06", type: "advancement", advancement: "aliveworkplace:built/library_3", criterion: ""}],
			rewards: [{id: "672907AD736620B7", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "10D345A5380A4C05",
			x: 6.0d,
			y: -2.0d,
			optional: true,
			title: "The Vintner",
			description: ["Get a Vintner and a bottle of Cider.", "", "Stand a villager right next to the cauldron, hold sweet berries, glow berries or an apple and sneak-right-click the villager: they become a Vintner.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "Keep apples and glass bottles in a chest by the cauldron: a Novice Vintner makes Cider from 3 apples and a bottle. Take one, or buy it from them.", "", "Artisans want Cider, and Burghers and Nobles the Vintner's wines.", "", "This quest completes by itself as soon as you have a bottle of Cider in your inventory."],
			dependencies: ["2111E4C5203EC081"],
			icon: {id: "aliveworkplace:cider", count: 1},
			tasks: [{id: "1B6BDD02F0B08589", type: "item", item: {id: "aliveworkplace:cider", count: 1}}],
			rewards: [{id: "63B7CF0D8410CDEF", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "1A77C2C925347CED",
			x: 6.0d,
			y: 2.0d,
			optional: true,
			title: "The Tailor",
			description: ["Get a Tailor and a set of Work Clothes.", "", "Stand a villager right next to the loom, hold string and sneak-right-click the villager: they become a Tailor.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "A Novice Tailor makes Work Clothes from 3 wool, 2 leather and a string in the chests by the loom. Take a set, or buy it from them.", "", "Artisans need Work Clothes, Burghers Fine Clothes and Nobles Noble Robes.", "", "This quest completes by itself as soon as you have a set of Work Clothes in your inventory."],
			dependencies: ["2111E4C5203EC081"],
			icon: {id: "aliveworkplace:work_clothes", count: 1},
			tasks: [{id: "1F06A8C6AF162416", type: "item", item: {id: "aliveworkplace:work_clothes", count: 1}}],
			rewards: [{id: "576453CBB8D33EEF", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "45E7830A7FC26D36",
			x: 9.0d,
			y: -2.0d,
			optional: true,
			title: "The Jeweler",
			description: ["Get a Jeweler and an Amethyst Ring.", "", "Stand a villager right next to the stonecutter, hold a gold nugget and sneak-right-click the villager: they become a Jeweler.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "Only a villager of a Burgher household or better can be a Jeweler. A Novice makes Amethyst Rings from 2 amethyst shards and 2 copper ingots in the chests by the stonecutter. Take one, or buy it from them.", "", "Burghers want rings, and Nobles need the Jeweler's brooches.", "", "This quest completes by itself as soon as you have an Amethyst Ring in your inventory."],
			dependencies: ["13BCA5AD7D9D18F4"],
			icon: {id: "aliveworkplace:amethyst_ring", count: 1},
			tasks: [{id: "6AF4F33DB1B9EAD7", type: "item", item: {id: "aliveworkplace:amethyst_ring", count: 1}}],
			rewards: [{id: "68ECF31F072FC70A", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "77BD93C35A05ED04",
			x: 9.0d,
			y: 2.0d,
			optional: true,
			title: "The Printer",
			description: ["Get a Printer and a copy of the Village Gazette.", "", "Stand a villager right next to the cartography table, hold an ink sac and sneak-right-click the villager: they become a Printer.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "Only a villager of an Artisan household or better can be a Printer. A Novice prints the Gazette from 3 paper and an ink sac in the chests by the table. Take a copy, or buy it from them.", "", "Burghers need the Gazette every week.", "", "This quest completes by itself as soon as you have a Village Gazette in your inventory."],
			dependencies: ["13BCA5AD7D9D18F4"],
			icon: {id: "aliveworkplace:gazette", count: 1},
			tasks: [{id: "31B38A5253EB4512", type: "item", item: {id: "aliveworkplace:gazette", count: 1}}],
			rewards: [{id: "131C0871D52BFC1F", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "499E66E7A5F5EB9C",
			x: 18.0d,
			y: -2.0d,
			optional: true,
			title: "The Realm Map",
			description: ["Draw a map of your whole realm.", "", "1. Carry an empty map.", "2. Open the hall's Realm tab (minecart, then Realm) and draw the Realm Map.", "", "The whole realm on one sheet, under your realm's arms.", "", "Click the checkmark above once you've drawn the Realm Map."],
			dependencies: ["4B5E6D68C7EDDF14"],
			icon: {id: "minecraft:map", count: 1},
			tasks: [{id: "3E34575A2F8DB180", type: "checkmark", title: "I drew the Realm Map"}],
			rewards: [{id: "41BD5FBB2D05B9D3", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "410C0781C61E0E6C",
			x: 18.0d,
			y: 2.0d,
			optional: true,
			title: "A pact",
			description: ["Make a pact with another player's village.", "", "1. Open the Village Hall, click the minecart (Trade routes), then the Pacts tab.", "2. Offer a trade pact or an alliance to another player's village.", "", "Allies' guards ride to your aid when you're raided.", "", "Click the checkmark above once your village has a pact with another player's."],
			dependencies: ["4B5E6D68C7EDDF14"],
			tasks: [{id: "7A1106333AE6F576", type: "checkmark", title: "My village has a pact with another player's"}],
