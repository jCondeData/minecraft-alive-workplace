	order_index: 101,
	filename: "aliveworkplace_story_2_hamlet",
	title: "2. The Hamlet Grows",
	subtitle: ["More homes, a crew of builders, the first quests and a market"],
	icon: {id: "minecraft:oak_door", count: 1},
	default_quest_shape: "",
	default_hide_dependency_lines: false,
	quests: [
		{
			id: "7C7AE0692A2E0733",
			x: 0.0d,
			y: 0.0d,
			title: "A Stone House",
			description: ["Build a Stone House: more beds for more villagers.", "", "1. Right-click the Blueprint Table, pick the Stone House and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "", "Every free bed lets one more baby be born. The reward puts Stone House II in your Blueprint Table.", "", "This quest completes by itself when the builder finishes the Stone House."],
			dependencies: ["7E5F1283760B111A"],
			icon: {id: "minecraft:cobblestone", count: 1},
			tasks: [{id: "438EC844EAD0DEA2", type: "advancement", advancement: "aliveworkplace:built/stone_house", criterion: ""}],
			rewards: [{id: "6BCA7901E836E87C", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}, {id: "1518E7C567CE2E24", type: "command", command: "/workplace unlock {p} aliveworkplace:stone_house_2", elevate_perms: true, silent: true}]
		},
		{
			id: "27FFFFBF2277B6E3",
			x: 3.0d,
			y: 0.0d,
			title: "A Terrace",
			description: ["Build a Terrace: two row houses under one roof, with four beds.", "", "1. Right-click the Blueprint Table, pick the Terrace and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "", "It's the quickest way to give a growing village lots of beds. The reward puts Terrace II in your Blueprint Table.", "", "This quest completes by itself when the builder finishes the Terrace."],
			dependencies: ["7C7AE0692A2E0733"],
			icon: {id: "minecraft:spruce_door", count: 1},
			tasks: [{id: "65B21720EBD51CDD", type: "advancement", advancement: "aliveworkplace:built/terrace", criterion: ""}],
			rewards: [{id: "5D9BF05AE3981CB7", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}, {id: "25B593E9D36DD101", type: "command", command: "/workplace unlock {p} aliveworkplace:terrace_2", elevate_perms: true, silent: true}]
		},
		{
			id: "1D5A78DCEAAACF0B",
			x: 6.0d,
			y: 0.0d,
			title: "A second builder",
			description: ["Get a second Builder with the Builder's Workshop.", "", "1. Right-click the Blueprint Table, pick the Builder's Workshop and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. A villager without a job takes the workshop's Blueprint Table and becomes your second Builder.", "", "Two builders get twice as much done, and in the next quest they work together.", "", "This quest completes by itself when the builder finishes the Builder's Workshop."],
			dependencies: ["27FFFFBF2277B6E3"],
			icon: {id: "aliveworkplace:blueprint_table", count: 1},
			tasks: [{id: "164442E5DD3C3C10", type: "advancement", advancement: "aliveworkplace:built/builders_workshop", criterion: ""}],
			rewards: [{id: "774241D92293BD7B", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "638D622A34F70944",
			x: 9.0d,
			y: 0.0d,
			title: "A crew",
			description: ["Have both your builders work on one build.", "", "A builder with nothing to do helps with a build whose Blueprint Table is within 48 blocks of their own (up to three helpers on one build).", "", "1. Make sure your second builder has no build of their own.", "2. Give your first builder a blueprint, as usual.", "3. Watch: the second builder joins in, and the line over their head says \"Helping\" and the first builder's name.", "", "A crew of four finishes a build in under a third of the time. A busy builder also keeps up to five more blueprints and builds them in order.", "", "Click the checkmark above once you've seen your second builder helping."],
			dependencies: ["1D5A78DCEAAACF0B"],
			tasks: [{id: "219B08EBBECDCD48", type: "checkmark", title: "Two builders worked on one build"}],
			rewards: [{id: "7A12F69E680DB178", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "7984F5F72F1183D5",
			x: 12.0d,
			y: 0.0d,
			title: "Help the village",
			description: ["Finish one of the quests your village puts up at the hall.", "", "1. Open the Village Hall and click the map (Quests) at the top right. A new quest goes up each morning: three at most, each for three days.", "2. Hover over a quest to see what it asks:", "- bring something: carry it and click the quest to hand it in;", "- defeat monsters near the hall;", "- beat one of the village's Pokémon trainers (with Cobblemon).", "", "They pay in emeralds, a quarter more for every rank the village has.", "", "This quest completes by itself when you finish one of the village's quests."],
			dependencies: ["638D622A34F70944"],
			icon: {id: "minecraft:map", count: 1},
			tasks: [{id: "5153B5C4844B46FA", type: "advancement", advancement: "aliveworkplace:village/hall_quest", criterion: ""}],
			rewards: [{id: "1234BA904F3A82D5", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}, {id: "3C60BACB22E2DC32", type: "command", command: "/workplace unlock {p} aliveworkplace:market_square", elevate_perms: true, silent: true}]
		},
		{
			id: "3C8F7F7EE3EF08EB",
			x: 15.0d,
			y: 0.0d,
			shape: "gear",
			size: 1.5d,
			title: "The market",
			description: ["Build the Market Square: paving, awnings, flowers, a fountain and a bell.", "", "The reward of the last quest (Help the village) put it in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick the Market Square and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "", "Once a week your village then holds a market: in the morning two traveling traders come to the square, and each also sells a blueprint for 6 emeralds.", "", "Next goal: with 10 villagers and 5 finished buildings your Hamlet becomes a Village. Open the Village Hall (right-click it) and hover over the name tag at the top left: the yellow line says what the next rank still needs.", "", "This quest completes by itself when the builder finishes the Market Square."],
			dependencies: ["7984F5F72F1183D5"],
			icon: {id: "minecraft:bell", count: 1},
			tasks: [{id: "5CE847F1B3DFC3C1", type: "advancement", advancement: "aliveworkplace:built/market_square", criterion: ""}],
			rewards: [{id: "1529B1359CA5C953", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}, {id: "7D87C16F215AFB4F", type: "xp", xp: 300}]
		},
		{
			id: "4BC08EDAC4B2CFA1",
			x: 0.0d,
			y: -2.0d,
			optional: true,
			title: "A Market Stall",
			description: ["Build a Market Stall: a striped awning over a counter.", "", "1. Buy the Market Stall blueprint from an Apprentice Builder (level 2) for 8 emeralds: right-click them to see their trades.", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of your builder's Blueprint Table.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint.", "", "Its upgrade, Market Stall II, adds a Shop Counter: a villager without a job takes it and becomes your Shopkeeper.", "", "This quest completes by itself when the builder finishes the Market Stall."],
			dependencies: ["7C7AE0692A2E0733"],
			icon: {id: "minecraft:barrel", count: 1},
			tasks: [{id: "3294E3671BBE4F1F", type: "advancement", advancement: "aliveworkplace:built/market_stall", criterion: ""}],
			rewards: [{id: "7A9FDD5FCD517011", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
		},
		{
			id: "51FBBEF686C11029",
			x: 3.0d,
			y: -2.0d,
			optional: true,
			title: "A guard before the first raid",
			description: ["Build the Guard House and get a Guard.", "", "1. Right-click the Blueprint Table, pick the Guard House and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. Stand a villager right next to the Guard House's grindstone, hold a sword and sneak-right-click the villager: they become a Guard.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "", "Once a village with a hall has 8 villagers, monsters may raid it at night. Guards fight off monsters near their post.", "", "This quest completes by itself when the builder finishes the Guard House."],
			dependencies: ["27FFFFBF2277B6E3"],
			icon: {id: "minecraft:iron_sword", count: 1},
			tasks: [{id: "1B2E3A051EE80041", type: "advancement", advancement: "aliveworkplace:built/guard_house", criterion: ""}],
			rewards: [{id: "446F75463B270EF1", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "525FF4017C83901A",
			x: 3.0d,
			y: -4.0d,
			optional: true,
			title: "A Training Dummy",
			description: ["Make a Training Dummy for your guards.", "", "Recipe: wool in the top middle; a stick, a hay bale and a stick across the middle; a stick in the bottom middle.", "Place it near the guard's grindstone.", "", "Guards spar with it to keep in practice.", "", "This quest completes by itself as soon as you have a Training Dummy in your inventory."],
			dependencies: ["51FBBEF686C11029"],
			icon: {id: "aliveworkplace:training_dummy", count: 1},
			tasks: [{id: "1B7ACAF4ECE01E1A", type: "item", item: {id: "aliveworkplace:training_dummy", count: 1}}],
			rewards: [{id: "1D3ED1015689ACD6", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
		},
		{
			id: "5C898410A42FD862",
			x: 6.0d,
			y: -2.0d,
			optional: true,
			title: "A Carpenter",
			description: ["Build the Carpenter's Workshop and get a Carpenter.", "", "1. Right-click the Blueprint Table, pick the Carpenter's Workshop and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. Stand a villager right next to the workshop's crafting table, hold planks and sneak-right-click the villager: they become a Carpenter.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "", "When a build is short of something that can be crafted (doors, stairs, fences...), the carpenter makes it from the chests and brings it over.", "", "This quest completes by itself when the builder finishes the Carpenter's Workshop."],
			dependencies: ["1D5A78DCEAAACF0B"],
			icon: {id: "minecraft:crafting_table", count: 1},
			tasks: [{id: "742400F7CBEBD83B", type: "advancement", advancement: "aliveworkplace:built/carpenters_workshop", criterion: ""}],
			rewards: [{id: "5CB97A1BD40CA050", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "6EE6C0128D844D89",
			x: 6.0d,
			y: 2.0d,
			optional: true,
			title: "A Miner",
			description: ["Build the Smithy and get a Miner.", "", "1. Right-click the Blueprint Table, pick the Smithy and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. Stand a villager right next to the Smithy's blast furnace, hold a pickaxe and sneak-right-click the villager: they become a Miner.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "Then craft a Quarry Marker (a stick, red dye and paper), right-click two opposite corners of the quarry with it and give it to the miner. Keep pickaxes and torches in a chest by the blast furnace.", "", "The miner brings back the stone and ore your builds need.", "", "This quest completes by itself when the builder finishes the Smithy."],
			dependencies: ["1D5A78DCEAAACF0B"],
			icon: {id: "aliveworkplace:quarry_marker", count: 1},
			tasks: [{id: "575505C0E0342130", type: "advancement", advancement: "aliveworkplace:built/smithy", criterion: ""}],
			rewards: [{id: "7E1E67C7D7CBC70D", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "41A60CA4BB946FF8",
			x: 6.0d,
			y: 4.0d,
			optional: true,
			title: "A Mason",
			description: ["Build the Mason's Yard and get a Mason.", "", "1. Right-click the Blueprint Table, pick the Mason's Yard and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. A villager without a job takes its stonecutter and becomes a Mason.", "", "The mason cuts the stone bricks, stairs and walls your builders are waiting for.", "", "This quest completes by itself when the builder finishes the Mason's Yard."],
			dependencies: ["6EE6C0128D844D89"],
			icon: {id: "minecraft:stonecutter", count: 1},
			tasks: [{id: "7F9755333C80632A", type: "advancement", advancement: "aliveworkplace:built/masons_yard", criterion: ""}],
			rewards: [{id: "461B4DC1DA513A5A", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "1FE72389CBA9260D",
			x: 9.0d,
			y: -2.0d,
			optional: true,
			title: "Your own builds: the Scan Tool",
			description: ["Turn something you built into a blueprint with the Scan Tool.", "", "1. Craft a Blank Blueprint and a spyglass together.", "2. Right-click one corner block of your build, then the opposite corner.", "3. Sneak-right-click the air. With a Blank Blueprint in your inventory, you get a blueprint of it.", "", "Your builders can then build copies of it, and it's in the Blueprint Table for everyone.", "", "This quest completes by itself as soon as you have a Scan Tool in your inventory."],
			dependencies: ["638D622A34F70944"],
			icon: {id: "aliveworkplace:scan_tool", count: 1},
			tasks: [{id: "1C0210FBF73DE271", type: "item", item: {id: "aliveworkplace:scan_tool", count: 1}}],
			rewards: [{id: "7FDAA0BB857C9A20", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "7C825050F0141CA1",
			x: 9.0d,
			y: -4.0d,
			optional: true,
			title: "The Shape Planner",
			description: ["Draw shapes as blueprints with the Shape Planner.", "", "1. Craft a Blank Blueprint and a compass together.", "2. Right-click to open it. Pick a shape (box, cylinder, dome, sphere, cone, pyramid or arch), its size and a block you carry.", "3. Press Draw the blueprint: it turns a Blank Blueprint into a blueprint for your builder.", "", "Towers, domes and walls without placing a block yourself.", "", "This quest completes by itself as soon as you have a Shape Planner in your inventory."],
			dependencies: ["1FE72389CBA9260D"],
			icon: {id: "aliveworkplace:shape_planner", count: 1},
			tasks: [{id: "11147B37B3DD2548", type: "item", item: {id: "aliveworkplace:shape_planner", count: 1}}],
			rewards: [{id: "7FAF40CE72CCF776", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "53BC08BBFADACF78",
			x: 9.0d,
			y: 2.0d,
			optional: true,
			title: "Pokémon at work",
			description: ["Let your Pokémon help your villagers work.", "", "1. Craft a Pasture Block: three planks on top; planks, a PC and planks in the middle; wheat, a hopper and wheat at the bottom.", "2. Place it within 16 blocks of a worker's workstation and put Pokémon in it.", "3. Each Pokémon of a type that suits the job makes the work faster, up to three helpers. Fighting, Rock and Steel help builders; Grass, Ground and Water help farmers.", "", "The line over the worker's head says who's helping (\"with Machop\").", "", "This quest completes by itself as soon as you have a Pasture Block in your inventory."],
			dependencies: ["638D622A34F70944"],
			icon: {id: "cobblemon:pasture", count: 1},
			tasks: [{id: "37FBE50D2C8C58F5", type: "item", item: {id: "cobblemon:pasture", count: 1}}],
			rewards: [{id: "6965D0218F6772FE", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "55456024EADC6E49",
			x: 12.0d,
			y: -2.0d,
			optional: true,
			title: "A village Trainer",
			description: ["Give your village a Pokémon Trainer.", "", "1. Craft a Training Post: a target block on top of three planks.", "2. Place it near a villager without a job: they take it and become a Trainer.", "3. Right-click the trainer with an empty hand to battle.", "", "Beating a trainer pays, once a day per trainer, and some of the hall's quests ask for it.", "", "This quest completes by itself as soon as you have a Training Post in your inventory."],
			dependencies: ["7984F5F72F1183D5"],
			icon: {id: "aliveworkplace:training_post", count: 1},
			tasks: [{id: "5569469BFC7E6FEA", type: "item", item: {id: "aliveworkplace:training_post", count: 1}}],
			rewards: [{id: "59D11D0065829189", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		}
	],
