	quests: [
		{
			id: "7C7AE0692A2E0733",
			x: 0.0d,
			y: 0.0d,
			title: "A Stone House",
			description: ["More beds, more villagers. The Stone House is a sturdy stone cottage with a bed downstairs and one in the attic. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it. A build shown greyed out at the Table isn't unlocked yet: the Table says how to get it."],
			dependencies: ["7E5F1283760B111A"],
			icon: {id: "minecraft:cobblestone", count: 1},
			tasks: [{id: "438EC844EAD0DEA2", type: "advancement", advancement: "aliveworkplace:built/stone_house", criterion: ""}],
			rewards: [{id: "6BCA7901E836E87C", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}, {id: "1518E7C567CE2E24", type: "command", command: "/workplace unlock {p} aliveworkplace:stone_house_2", elevate_perms: true, silent: true}]
		},
		{
			id: "27FFFFBF2277B6E3",
			x: 3.0d,
			y: 0.0d,
			title: "A Terrace",
			description: ["Two row houses of two stories under one roof, with four beds: the quickest way to give a growing village lots of beds. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it. A build shown greyed out at the Table isn't unlocked yet: the Table says how to get it."],
			dependencies: ["7C7AE0692A2E0733"],
			icon: {id: "minecraft:spruce_door", count: 1},
			tasks: [{id: "65B21720EBD51CDD", type: "advancement", advancement: "aliveworkplace:built/terrace", criterion: ""}],
			rewards: [{id: "5D9BF05AE3981CB7", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}, {id: "25B593E9D36DD101", type: "command", command: "/workplace unlock {p} aliveworkplace:terrace_2", elevate_perms: true, silent: true}]
		},
		{
			id: "1D5A78DCEAAACF0B",
			x: 6.0d,
			y: 0.0d,
			title: "A second builder",
			description: ["Build the Builder's Workshop: a bed, a crafting table, a chest and a Blueprint Table. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it. A build shown greyed out at the Table isn't unlocked yet: the Table says how to get it.", "", "A villager without a job takes its table and becomes your second builder."],
			dependencies: ["27FFFFBF2277B6E3"],
			icon: {id: "aliveworkplace:blueprint_table", count: 1},
			tasks: [{id: "164442E5DD3C3C10", type: "advancement", advancement: "aliveworkplace:built/builders_workshop", criterion: ""}],
			rewards: [{id: "774241D92293BD7B", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "638D622A34F70944",
			x: 9.0d,
			y: 0.0d,
			title: "A crew",
			description: ["Builders with nothing to do join a build near their table (up to three helpers), so a crew of four finishes in under a third of the time. Busy builders also queue up to five more blueprints and build them in order.", "", "Hand one builder a blueprint while the other is free, and watch them both at it."],
			dependencies: ["1D5A78DCEAAACF0B"],
			tasks: [{id: "219B08EBBECDCD48", type: "checkmark", title: "Two builders worked on one build"}],
			rewards: [{id: "7A12F69E680DB178", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "7984F5F72F1183D5",
			x: 12.0d,
			y: 0.0d,
			title: "Help the village",
			description: ["Each morning the village may put up a quest at the hall, three at most, each up for three days. Open the hall and click Quests (the map icon).", "", "Bring what a worker is waiting for (click the quest to hand it in), slay 8 monsters round the village, or beat one of its trainers. It pays in emeralds, a quarter more for every rank.", "", "This ticks off by itself when you finish one."],
			dependencies: ["638D622A34F70944"],
			icon: {id: "minecraft:map", count: 1},
			tasks: [{id: "5153B5C4844B46FA", type: "advancement", advancement: "aliveworkplace:village/hall_quest", criterion: ""}],
			rewards: [{id: "1234BA904F3A82D5", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "3C8F7F7EE3EF08EB",
			x: 15.0d,
			y: 0.0d,
			shape: "gear",
			size: 1.5d,
			title: "The market",
			description: ["Build the Market Square: paving, colored awnings, flowers, a fountain and a bell, the prettiest decoration there is. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it. A build shown greyed out at the Table isn't unlocked yet: the Table says how to get it.", "", "Once a week it holds a market: in the morning two traveling traders come to the square, each also selling a blueprint for 6 emeralds.", "", "Next: with 10 villagers and 5 finished buildings your Hamlet becomes a Village. Hover over the hall's name icon to see what it still needs."],
			dependencies: ["7984F5F72F1183D5"],
			icon: {id: "minecraft:bell", count: 1},
			tasks: [{id: "5CE847F1B3DFC3C1", type: "advancement", advancement: "aliveworkplace:built/market_square", criterion: ""}],
			rewards: [{id: "1529B1359CA5C953", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}, {id: "7D87C16F215AFB4F", type: "xp", xp: 300}]
		},
		{
			id: "4BC08EDAC4B2CFA1",
			x: 0.0d,
			y: -2.0d,
			optional: true,
			title: "A Market Stall",
			description: ["A striped awning over a spruce counter. Its upgrade, Market Stall II, adds a Shop Counter: a villager without a job takes it and becomes your Shopkeeper. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it. A build shown greyed out at the Table isn't unlocked yet: the Table says how to get it."],
			dependencies: ["7C7AE0692A2E0733"],
			icon: {id: "minecraft:barrel", count: 1},
			tasks: [{id: "3294E3671BBE4F1F", type: "advancement", advancement: "aliveworkplace:built/market_stall", criterion: ""}],
			rewards: [{id: "7A9FDD5FCD517011", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
