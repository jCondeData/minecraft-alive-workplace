	quests: [
		{
			id: "545DDA9712467290",
			x: 0.0d,
			y: 0.0d,
			title: "A Blueprint Table",
			subtitle: "Start here",
			description: ["In this world villagers do real jobs, and the first one you need is a Builder.", "", "Craft a Blueprint Table: blue dye on top, a cartography table in the middle, planks around it.", "Put it down near a villager without a job: they take it like any job block and become a Builder.", "", "No village nearby? See the side quest about the Settler's Wagon."],
			dependencies: [],
			icon: {id: "aliveworkplace:blueprint_table", count: 1},
			tasks: [{id: "3105BAE4E815E3F6", type: "item", item: {id: "aliveworkplace:blueprint_table", count: 1}}],
			rewards: [{id: "61C19E5A33C0CBD3", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
		},
		{
			id: "1A8DAA1696E4732B",
			x: 6.0d,
			y: 0.0d,
			title: "Build a Starter Cottage",
			subtitle: "Your first home, and the start of a village",
			description: ["The Starter Cottage is a little timber cottage with a bed: your village's first home.", "", "1. Paper and blue dye make two Blank Blueprints. At the Blueprint Table, pick the Starter Cottage and press Get Blueprint.", "2. Hold the blueprint and right-click the ground where the front should go: the gold edge is the front. Sneak-right-click to turn it.", "3. Fill chests or barrels within 8 blocks of the Blueprint Table with what the blueprint lists when you hold Shift over it.", "4. Right-click the builder with the blueprint.", "", "What the builder is doing, or waiting for, floats over their head. This quest ticks off by itself when the cottage is finished."],
			dependencies: ["545DDA9712467290"],
			icon: {id: "aliveworkplace:blueprint", count: 1},
			tasks: [{id: "31103B7FFC5E948A", type: "advancement", advancement: "aliveworkplace:built/starter_cottage", criterion: ""}],
			rewards: [{id: "2EAD0E9502DA4E67", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 5}, {id: "1D322B742080BC03", type: "xp", xp: 150}]
		},
		{
			id: "22BCDE77E8F346B1",
			x: 9.0d,
			y: 0.0d,
			title: "The Village Hall",
			description: ["A Village Hall turns a few villagers into a village: names, moods, needs, a rank and a treasury.", "", "Craft one: gold, a book and gold over planks, an emerald in the middle. Put it in the middle of your village (by the bell is a good spot): everyone within 64 blocks lives there.", "", "Right-click it to see who lives there, what they're doing and what they need. The hall's What next? button (the compass) always lists what the village lacks most."],
			dependencies: ["1A8DAA1696E4732B"],
			icon: {id: "aliveworkplace:village_hall", count: 1},
			tasks: [{id: "766712E709798220", type: "item", item: {id: "aliveworkplace:village_hall", count: 1}}],
			rewards: [{id: "523CA5B3782BC736", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "2FF91C8889257D71",
			x: 12.0d,
			y: 0.0d,
			title: "The first job: a Farmer",
			description: ["Villagers eat once a day from the village's store, so food comes first.", "", "Build the Farmstead: a farmhouse with a bed beside a field round a water channel, with a composter. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it.", "", "A villager without a job takes the composter and farms the field. Put seeds (and a hoe for bare dirt) in a chest by the composter."],
			dependencies: ["22BCDE77E8F346B1"],
			icon: {id: "minecraft:composter", count: 1},
			tasks: [{id: "4986A987A5133CAD", type: "advancement", advancement: "aliveworkplace:built/farmstead", criterion: ""}],
			rewards: [{id: "13DFC0218300757E", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "5551A3691AB8CA09",
			x: 15.0d,
			y: 0.0d,
			title: "A Porter: the Storehouse",
			description: ["Build the Storehouse: a granary with a Storehouse block and eight chests. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it.", "", "A villager without a job takes the Storehouse block and becomes a Porter: they walk round the other workers and carry what they make (the farmer's harvest too) to the storehouse, where the whole village finds it."],
			dependencies: ["2FF91C8889257D71"],
			icon: {id: "aliveworkplace:storehouse", count: 1},
			tasks: [{id: "20C6EBAC4E2EAFD3", type: "advancement", advancement: "aliveworkplace:built/storehouse", criterion: ""}],
			rewards: [{id: "3A7B62CD3AB912B4", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "1A00E14DF6D87643",
			x: 18.0d,
			y: 0.0d,
			title: "Food in the store",
			description: ["The store is the chests by the village's smokers and Kitchen Stoves, then the chests by its Storehouses. Anything plain to eat counts as a meal: bread, baked potatoes, cooked fish, pies, apples, carrots.", "", "A village only grows when the store holds at least 16 meals. Let the farmer and the porter fill it, or put food in the storehouse chests yourself.", "", "The hall's top row shows how much food is in store. Tick this once it says 16 or more."],
			dependencies: ["5551A3691AB8CA09"],
			icon: {id: "minecraft:bread", count: 1},
			tasks: [{id: "59A9F0FD9822F906", type: "checkmark", title: "My village has 16 meals or more in store"}],
			rewards: [{id: "7701DA3F2C0D5F87", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "7E5F1283760B111A",
			x: 21.0d,
			y: 0.0d,
			shape: "gear",
			size: 1.5d,
			title: "A bed for a newcomer",
			description: ["A village grows by itself: at most once a day a couple has a baby, when the village has a free bed nobody has claimed, 16 meals in store, at least two grown villagers and is at least half well kept (fed, housed and safe enough).", "", "Every bed in your buildings counts. If nobody is born, the hall's villager count says what's holding the village back.", "", "Tick this when your village's first baby is born. Then turn the page: the Hamlet grows."],
			dependencies: ["1A00E14DF6D87643"],
			icon: {id: "minecraft:red_bed", count: 1},
			tasks: [{id: "148C4F6E80741491", type: "checkmark", title: "A baby was born in my village"}],
			rewards: [{id: "44230518AC237E80", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 6}, {id: "4AD8FB9949014FA5", type: "xp", xp: 200}]
		},
		{
