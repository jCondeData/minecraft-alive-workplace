	quests: [
		{
			id: "79EBDD6DE97214DD",
			x: 0.0d,
			y: 0.0d,
			title: "A Village at last",
			description: ["With 10 villagers and 5 finished buildings near its hall, a Hamlet becomes a Village, with fireworks over the hall. Quests pay a quarter more, caravans reach one more village and the village may grow ten villagers bigger.", "", "Not there yet? Hover over the hall's name icon to see what's missing: build more homes for more villagers, and anything finished counts as a building. This ticks off by itself."],
			dependencies: ["3C8F7F7EE3EF08EB"],
			icon: {id: "aliveworkplace:village_hall", count: 1},
			tasks: [{id: "13C933544EE70859", type: "advancement", advancement: "aliveworkplace:village/rank_village", criterion: ""}],
			rewards: [{id: "58FEC1BFB4226C8D", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}, {id: "19DEEEEBBD195402", type: "xp", xp: 200}]
		},
		{
			id: "2AA676DA8A58D35F",
			x: 3.0d,
			y: 0.0d,
			title: "The City Plan",
			description: ["A map, a Blank Blueprint and a Heart of the Sea make a City Plan, your village's master plan.", "", "Right-click your Village Hall with it to bind it to that village. Then right-click the air to open it and paint zones (homes, workshops, farms, the market...) with + New."],
			dependencies: ["79EBDD6DE97214DD"],
			icon: {id: "aliveworkplace:city_plan", count: 1},
			tasks: [{id: "5DD47F0F4DC167A6", type: "item", item: {id: "aliveworkplace:city_plan", count: 1}}],
			rewards: [{id: "2AD2F7CF6BC5E948", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "4536CBF3BF2F6B2A",
			x: 6.0d,
			y: 0.0d,
			title: "Appoint a Steward",
			description: ["A Steward plans the village and has the builders build it. He must be a Builder of Journeyman level or higher (about 350 blocks of steady work).", "", "Bring him beside the hall and sneak-right-click him with the hall's City Plan: he changes into a clerk's long coat. This ticks off by itself."],
			dependencies: ["2AA676DA8A58D35F"],
			icon: {id: "minecraft:writable_book", count: 1},
			tasks: [{id: "1284310662B8305C", type: "advancement", advancement: "aliveworkplace:village/steward", criterion: ""}],
			rewards: [{id: "64B26E13E3EB27D4", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 6}]
		},
		{
			id: "3960A49DE0FDF851",
			x: 9.0d,
			y: 0.0d,
			title: "The first festival",
			description: ["Every eight days a village with a hall and at least six villagers holds a festival: a feast from the store round the bell after work, music, dancing and fireworks at dusk. Everyone who came is in a better mood for two days.", "", "Can't wait? Click the hall's festival button with a cake to hold one sooner. The hall's calendar shows when the next one is. This ticks off by itself."],
			dependencies: ["4536CBF3BF2F6B2A"],
			icon: {id: "minecraft:cake", count: 1},
			tasks: [{id: "555B899C41225368", type: "advancement", advancement: "aliveworkplace:village/festival", criterion: ""}],
			rewards: [{id: "3C36CAE2C1BC686E", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "67AA0E243F95E6AA",
			x: 12.0d,
			y: 0.0d,
			title: "The first caravan",
			description: ["Villages with a hall supply each other. Click the minecart on the hall's screen for its trade routes: every other village with a hall within 2048 blocks, and what its workers are waiting for. Click one to send it caravans.", "", "Once a day a caravan takes them what they wait for from your storehouse's chests, keeping 16 of everything. No other village? Give one nearby a hall, or bring settlers with a Settler's Wagon. This ticks off by itself when the first caravan leaves."],
			dependencies: ["3960A49DE0FDF851"],
			icon: {id: "minecraft:chest_minecart", count: 1},
			tasks: [{id: "1CA9E2616B5BF69D", type: "advancement", advancement: "aliveworkplace:village/caravan", criterion: ""}],
			rewards: [{id: "2570C73883A4AA39", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "398FAF81FE717F9E",
			x: 15.0d,
			y: 0.0d,
			title: "Upgrades: Starter Cottage II",
			description: ["Most buildings have a bigger version. Once a builder finishes one, they sell its upgrade, and the Blueprint Table has it too.", "", "Right-click the finished cottage with the Starter Cottage II blueprint: it lines up exactly over it, and the builder only builds what's new, an upper story with a second bed. A bed in a tier II building is a fine home: happier villagers."],
			dependencies: ["67AA0E243F95E6AA"],
			icon: {id: "aliveworkplace:blueprint", count: 1},
			tasks: [{id: "19F998DF9C731542", type: "advancement", advancement: "aliveworkplace:built/starter_cottage_2", criterion: ""}],
			rewards: [{id: "60796A0BF52F4045", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "527BA8FAFB7389DE",
			x: 21.0d,
			y: 0.0d,
			title: "A Scholar: the Library",
			description: ["A Town needs research. Build the Library, a stone library with a lectern. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it.", "", "Sneak-right-click a villager by the lectern holding paper: they become a Scholar. Sneak-right-click the scholar with an empty hand to pick a topic."],
			dependencies: ["398FAF81FE717F9E"],
			icon: {id: "minecraft:lectern", count: 1},
			tasks: [{id: "2AC7A92F020125A6", type: "advancement", advancement: "aliveworkplace:built/library", criterion: ""}],
			rewards: [{id: "3C898FAE076FDF3F", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
