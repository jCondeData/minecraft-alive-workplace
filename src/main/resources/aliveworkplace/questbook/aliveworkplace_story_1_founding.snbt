{
	id: "387ACB35C020E38C",
	group: "",
	order_index: 100,
	filename: "aliveworkplace_story_1_founding",
	title: "1. Founding",
	subtitle: ["A builder, a first home, a Village Hall and the first jobs"],
	icon: {id: "aliveworkplace:blueprint_table", count: 1},
	default_quest_shape: "",
	default_hide_dependency_lines: false,
	quests: [
		{
			id: "545DDA9712467290",
			x: 0.0d,
			y: 0.0d,
			title: "A Blueprint Table",
			subtitle: "Start here",
			description: ["Get a Builder: a villager who builds whole buildings for you.", "", "1. Craft a Blueprint Table: blue dye in the top middle, a cartography table in the center with planks on its left and right, and planks in the two bottom corners.", "2. Place it a few blocks from a villager who has no job. They walk over, take it and become a Builder.", "", "No villager without a job near you? Do the side quest \"No village nearby?\" first.", "", "Almost every quest in this book needs a builder.", "", "This quest completes by itself as soon as you have a Blueprint Table in your inventory."],
			dependencies: [],
			icon: {id: "aliveworkplace:blueprint_table", count: 1},
			tasks: [{id: "3105BAE4E815E3F6", type: "item", item: {id: "aliveworkplace:blueprint_table", count: 1}}],
			rewards: [{id: "61C19E5A33C0CBD3", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
		},
		{
			id: "1A8DAA1696E4732B",
			x: 6.0d,
			y: 0.0d,
			title: "Build a Starter Cottage",
			subtitle: "Your first home, and the start of a village",
			description: ["Have your builder build a Starter Cottage, a little timber house with a bed.", "", "1. Right-click the Blueprint Table, pick the Starter Cottage and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "", "Sneak-right-click the ground with the blueprint to turn the outline. The line over the builder's head says what they're doing, or what they're still waiting for.", "", "Its bed is your village's first home, and this quest's reward puts Starter Cottage II in your Blueprint Table.", "", "This quest completes by itself when the builder finishes the Starter Cottage."],
			dependencies: ["545DDA9712467290"],
			icon: {id: "aliveworkplace:blueprint", count: 1},
			tasks: [{id: "31103B7FFC5E948A", type: "advancement", advancement: "aliveworkplace:built/starter_cottage", criterion: ""}],
			rewards: [{id: "2EAD0E9502DA4E67", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 5}, {id: "1D322B742080BC03", type: "xp", xp: 150}, {id: "514652768927B587", type: "command", command: "/workplace unlock {p} aliveworkplace:starter_cottage_2", elevate_perms: true, silent: true}]
		},
		{
			id: "22BCDE77E8F346B1",
			x: 9.0d,
			y: 0.0d,
			title: "Build the Village Hall",
			subtitle: "The heart of your village",
			description: ["Build a Village Hall in the middle of your village.", "", "1. Right-click the Blueprint Table, pick the Village Hall and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "", "When it's done, right-click the Village Hall block inside. The hall's screen shows everyone who lives within 64 blocks of it: their jobs, the beds, the food and what the workers are waiting for. The compass (What next?) in its second row lists what your village needs most.", "", "With a hall your villagers get names, needs and a village rank, and the rest of this book builds on it. The reward puts Village Hall II in your Blueprint Table.", "", "This quest completes by itself when the builder finishes the Village Hall."],
			dependencies: ["1A8DAA1696E4732B"],
			icon: {id: "aliveworkplace:village_hall", count: 1},
			tasks: [{id: "766712E709798220", type: "advancement", advancement: "aliveworkplace:built/village_hall", criterion: ""}],
			rewards: [{id: "523CA5B3782BC736", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 5}, {id: "7C7C5D79B1A26253", type: "xp", xp: 150}, {id: "1EF7D03B2E1DAEFC", type: "command", command: "/workplace unlock {p} aliveworkplace:village_hall_2", elevate_perms: true, silent: true}]
		},
		{
			id: "2FF91C8889257D71",
			x: 12.0d,
			y: 0.0d,
			title: "The first job: a Farmer",
			description: ["Build the Farmstead and get a Farmer growing food.", "", "1. Right-click the Blueprint Table, pick the Farmstead and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. A villager without a job takes its composter and becomes a Farmer. They farm the field next to it by themselves.", "6. Put seeds, carrots or potatoes in a chest within 8 blocks of the composter, and a hoe if there's bare dirt to till.", "", "Villagers eat every day. Carrots and potatoes are food as they are; wheat only feeds anyone once a Chef bakes it into bread.", "", "This quest completes by itself when the builder finishes the Farmstead."],
			dependencies: ["22BCDE77E8F346B1"],
			icon: {id: "minecraft:composter", count: 1},
			tasks: [{id: "4986A987A5133CAD", type: "advancement", advancement: "aliveworkplace:built/farmstead", criterion: ""}],
			rewards: [{id: "13DFC0218300757E", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "5551A3691AB8CA09",
			x: 15.0d,
			y: 0.0d,
			title: "A Porter: the Storehouse",
			description: ["Build the Storehouse and get a Porter to carry goods for the village.", "", "1. Right-click the Blueprint Table, pick the Storehouse and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. A villager without a job takes its Storehouse block and becomes a Porter.", "", "The porter walks round the other workers, takes what they made (the farmer's harvest too) to the chests by the Storehouse block, and brings them the seeds and tools they need. Those chests are where the village keeps its food.", "", "This quest completes by itself when the builder finishes the Storehouse."],
			dependencies: ["2FF91C8889257D71"],
			icon: {id: "aliveworkplace:storehouse", count: 1},
			tasks: [{id: "20C6EBAC4E2EAFD3", type: "advancement", advancement: "aliveworkplace:built/storehouse", criterion: ""}],
			rewards: [{id: "3A7B62CD3AB912B4", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "1A00E14DF6D87643",
			x: 18.0d,
			y: 0.0d,
			title: "Food in the store",
			description: ["Fill your village's food chests with at least 16 meals.", "", "Villagers eat from the chests within 8 blocks of a Storehouse block or a smoker in the village. Those chests are the village's food store.", "", "1. Put plain food in them: bread, carrots, potatoes, baked potatoes, apples, cooked meat or cooked fish. Each item is one meal. (Golden food, rotten flesh, spider eyes, raw chicken, cake and Pokémon berries are not meals.)", "2. Or let the village fill them: the farmer grows carrots and potatoes, and the porter carries the harvest to the Storehouse chests.", "3. To check, right-click the Village Hall and hover over the bread in its top row: it says \"Food in store\" and a number.", "", "A village only has babies while the store holds 16 meals or more, and hungry villagers are unhappy and work slower.", "", "Click the checkmark above once the bread icon on the hall says Food in store: 16 or more (rotten flesh and the like are counted there too, so keep them out)."],
			dependencies: ["5551A3691AB8CA09"],
			icon: {id: "minecraft:bread", count: 1},
			tasks: [{id: "59A9F0FD9822F906", type: "checkmark", title: "The hall shows 16 or more food in store"}],
			rewards: [{id: "7701DA3F2C0D5F87", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "7E5F1283760B111A",
			x: 21.0d,
			y: 0.0d,
			shape: "gear",
			size: 1.5d,
			title: "A bed for a newcomer",
			description: ["Welcome your village's first baby.", "", "A couple has a baby, at most once a day, when all of these are true at once:", "- there's a free bed: a bed within 64 blocks of the hall that no villager has claimed;", "- the food store holds 16 meals or more (the last quest);", "- at least two grown villagers live there;", "- the village's wellbeing is at least half (the hall shows it as a percentage).", "", "1. Place a spare bed in one of your houses, or build another house.", "2. Open the Village Hall. In its top row, hover over the red bed (Beds) to see how many are free, and over the cake for the wellbeing.", "3. Hover over the emerald (Villagers) in the top row. Its last line says what's still missing, such as \"To grow: a free bed\", or \"A baby is on the way\".", "", "Babies are how your village grows, and more villagers bring the next rank.", "", "Click the checkmark above once the emerald on the hall says Born here: 1 or more. Then turn the page: the Hamlet grows."],
			dependencies: ["1A00E14DF6D87643"],
			icon: {id: "minecraft:red_bed", count: 1},
			tasks: [{id: "148C4F6E80741491", type: "checkmark", title: "A baby was born in my village"}],
			rewards: [{id: "44230518AC237E80", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 6}, {id: "4AD8FB9949014FA5", type: "xp", xp: 200}]
		},
		{
			id: "7AD411BBF0B0A3F8",
			x: 0.0d,
			y: -2.0d,
			optional: true,
			title: "The Guide Book",
			description: ["Get the Guide Book, a picture guide to villagers' jobs.", "", "You got one the first time you joined. Lost it? Craft a book and wheat together, anywhere in the crafting grid. Right-click it to read.", "", "It shows the basics (jobs, blueprints, the Village Hall) with a picture for each.", "", "This quest completes by itself as soon as you have a Guide Book in your inventory."],
			dependencies: ["545DDA9712467290"],
			icon: {id: "aliveworkplace:guide_book", count: 1},
			tasks: [{id: "26DFD919D4964EA3", type: "item", item: {id: "aliveworkplace:guide_book", count: 1}}],
			rewards: [{id: "70BBF793F2282DAC", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 1}]
		},
		{
			id: "1C8B79D8D2783547",
			x: 0.0d,
			y: 2.0d,
			optional: true,
			title: "No village nearby?",
			description: ["Start a village anywhere with a Settler's Wagon.", "", "1. Craft a Settler's Wagon: three white wool on top; a hay bale, a block of emerald and a hay bale in the middle; planks, a chest and planks at the bottom.", "2. Right-click open ground with it.", "3. Two settlers make camp there, with a wagon of supplies: building materials, food, two blueprints and a Village Hall to place. One settler is already your Builder; give the other any job.", "", "Use it when there's no village near you, or to start a second one.", "", "This quest completes by itself as soon as you have a Settler's Wagon in your inventory. You can place it afterwards."],
			dependencies: ["545DDA9712467290"],
			icon: {id: "aliveworkplace:settlers_wagon", count: 1},
			tasks: [{id: "26057102BBE74B72", type: "item", item: {id: "aliveworkplace:settlers_wagon", count: 1}}],
			rewards: [{id: "34DCA831ADD2512F", type: "xp", xp: 100}]
		},
		{
			id: "357F81DBD0D10863",
			x: 3.0d,
			y: -2.0d,
			optional: true,
			title: "Your Pokémon partner",
			description: ["Choose your first Pokémon.", "", "The first time you play, Cobblemon offers you a starter Pokémon. Pick the one you like best.", "", "Later, Pokémon of the right type help your villagers work faster.", "", "Click the checkmark above once your starter is in your party."],
			dependencies: ["545DDA9712467290"],
			icon: {id: "cobblemon:poke_ball", count: 1},
			tasks: [{id: "422BBAF0DF387019", type: "checkmark", title: "My starter is in my party"}],
			rewards: [{id: "7D17A0893D89C8CD", type: "xp", xp: 50}]
		},
		{
			id: "15F6BA42DB816CFF",
			x: 3.0d,
			y: -4.0d,
			optional: true,
			title: "Your first catch",
			description: ["Catch a wild Pokémon.", "", "1. Craft Poké Balls: a copper ingot in the middle with a red apricorn above, below, left and right of it. That makes four.", "2. Battle a wild Pokémon with your partner to weaken it.", "3. Throw a Poké Ball at it. The lower its health, the better your chances.", "", "Each Pokémon you catch can become a helper for your villagers.", "", "This quest completes by itself when you catch your first Pokémon."],
			dependencies: ["357F81DBD0D10863"],
			tasks: [{id: "16D5ECBDFFBAF87E", type: "advancement", advancement: "cobblemon:first_catch", criterion: ""}],
			rewards: [{id: "43459A9F1D31F801", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "570A3FB39796CD9F",
			x: 3.0d,
			y: -6.0d,
			optional: true,
			title: "A Healing Machine",
			description: ["Craft a Healing Machine for your base.", "", "Recipe: three copper ingots on top; an iron ingot, a Max Revive and an iron ingot in the middle; an iron ingot, redstone and an iron ingot at the bottom.", "", "It heals your whole team. In a village, a Nurse also heals you and your team: right-click them with an empty hand.", "", "This quest completes by itself as soon as you have a Healing Machine in your inventory."],
			dependencies: ["15F6BA42DB816CFF"],
			icon: {id: "cobblemon:healing_machine", count: 1},
			tasks: [{id: "29585EF89AD9024E", type: "item", item: {id: "cobblemon:healing_machine", count: 1}}],
			rewards: [{id: "3ED28ADD30E8C0D0", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "7075454B2620A7D4",
			x: 3.0d,
			y: -8.0d,
			optional: true,
			title: "Trainers on the road",
			description: ["Beat a trainer you meet in the world.", "", "With Radical Cobblemon Trainers, trainers walk the world. Right-click one to battle them.", "", "Beating trainers raises your level cap.", "", "This quest completes by itself when you win your first trainer battle."],
			dependencies: ["15F6BA42DB816CFF"],
			tasks: [{id: "31FD7D0EBACF7237", type: "advancement", advancement: "rctmod:trainers/defeat_any", criterion: ""}],
			rewards: [{id: "1B11F472415A7E18", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "487097AE4D79651A",
			x: 6.0d,
			y: -2.0d,
			optional: true,
			title: "Build with friends",
			description: ["Let your friends give orders to your builders.", "", "The first player to hand a builder a blueprint hires them, and only that player can give them orders.", "", "1. Type /workplace friend add followed by your friend's name.", "2. Now your builders take their blueprints too.", "", "Friends can share the work of building a village.", "", "Click the checkmark above once you've added a friend."],
			dependencies: ["1A8DAA1696E4732B"],
			tasks: [{id: "1DC4417016CA4D4D", type: "checkmark", title: "I added a friend with /workplace friend add"}],
			rewards: [{id: "58C74540E88AD41B", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 1}]
		},
		{
			id: "24F36240435F2CA1",
			x: 9.0d,
			y: -2.0d,
			optional: true,
			title: "The Village Ledger",
			description: ["Open the hall's screen from anywhere with a Village Ledger.", "", "1. Craft a book and an emerald together.", "2. Right-click your Village Hall with it to tie it to your village.", "3. From then on, right-click the air while holding it to open the hall's screen without walking back.", "", "It saves a lot of walking while you watch your village.", "", "This quest completes by itself as soon as you have a Village Ledger in your inventory."],
			dependencies: ["22BCDE77E8F346B1"],
			icon: {id: "aliveworkplace:village_ledger", count: 1},
			tasks: [{id: "3EC5011F8D9D34D8", type: "item", item: {id: "aliveworkplace:village_ledger", count: 1}}],
			rewards: [{id: "120B14A7FE7FF103", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
		},
		{
			id: "183449AABAA05E91",
			x: 12.0d,
			y: -2.0d,
			optional: true,
			title: "More fields",
			description: ["Give your farmer a second field with a Field Marker.", "", "1. Craft a stick, wheat seeds and paper together.", "2. Right-click one corner of the field, then the opposite corner (up to 32 by 32 blocks). It must be within 48 blocks of the farmer's composter.", "3. Right-click your farmer with the marker.", "", "More fields, more food for the store.", "", "This quest completes by itself as soon as you have a Field Marker in your inventory."],
			dependencies: ["2FF91C8889257D71"],
			icon: {id: "aliveworkplace:field_marker", count: 1},
			tasks: [{id: "67B0E01F3BE13ED5", type: "item", item: {id: "aliveworkplace:field_marker", count: 1}}],
			rewards: [{id: "334DAA47C7F58D74", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
		},
		{
			id: "7A9D7A8F906D2803",
			x: 15.0d,
			y: -2.0d,
			optional: true,
			title: "A Drop Box",
			description: ["Make a Drop Box for your loot.", "", "1. Craft a barrel and a hopper together.", "2. Place it within 48 blocks of the Storehouse block.", "3. Drop anything into it: the porter carries it to the Storehouse chests.", "", "Empty your bags in one place and the village sorts it out.", "", "This quest completes by itself as soon as you have a Drop Box in your inventory."],
			dependencies: ["5551A3691AB8CA09"],
			icon: {id: "aliveworkplace:drop_box", count: 1},
			tasks: [{id: "5220856F5314B6F2", type: "item", item: {id: "aliveworkplace:drop_box", count: 1}}],
			rewards: [{id: "188E325B2EE042A0", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
		},
		{
			id: "4875924559EEEA50",
			x: 18.0d,
			y: -2.0d,
			optional: true,
			title: "A Chef: the Kitchen",
			description: ["Build the Kitchen and get a Chef cooking for the village.", "", "1. Right-click the Blueprint Table, pick the Kitchen and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. Stand a villager right next to the Kitchen's smoker, hold raw meat, raw fish or a potato and sneak-right-click the villager: they become a Chef.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "", "The chef cooks bread, pies, stews and roasts into the chests by the smoker, which are part of the food store. Three or more kinds of meal in the store make villagers happier.", "", "This quest completes by itself when the builder finishes the Kitchen."],
			dependencies: ["1A00E14DF6D87643"],
			icon: {id: "minecraft:smoker", count: 1},
			tasks: [{id: "1CAAAC2D260502FD", type: "advancement", advancement: "aliveworkplace:built/kitchen", criterion: ""}],
			rewards: [{id: "66D9FDA702BEA8A0", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		}
	],
	quest_links: [],
	images: []
}
