			y: 3.0d,
			title: "The Netherworker: a Nether Gate",
			description: ["The Netherworker has no table of their own: they work at a Cartography Table. Build the Nether Gate, an obsidian portal in a blackstone arch with a cartography table (put a flint and steel in the chests and the builder lights it), and sneak-right-click a villager by the table holding netherrack.", "", "They go through the portal and come back a few minutes later with a bag of Nether goods."],
			dependencies: ["79FA173D6BCC862A"],
			icon: {id: "minecraft:netherrack", count: 1},
			tasks: [{id: "6C584545A17B3139", type: "advancement", advancement: "aliveworkplace:built/nether_gate", criterion: ""}],
