{
	id: "1F1F91406833C28D",
	group: "",
	order_index: 102,
	filename: "aliveworkplace_story_3_village",
	title: "3. A Village",
	subtitle: ["A Steward, caravans, festivals and upgrades"],
	icon: {id: "aliveworkplace:city_plan", count: 1},
	default_quest_shape: "",
	default_hide_dependency_lines: false,
	quests: [
		{
			id: "79EBDD6DE97214DD",
			x: 0.0d,
			y: 0.0d,
			title: "A Village at last",
			description: ["Grow your Hamlet into a Village: 10 villagers and 5 finished buildings.", "", "1. Open the Village Hall (right-click it) and hover over the name tag at the top left: the yellow line says what the next rank still needs.", "2. More villagers: build houses with beds and keep the food store full, so babies are born.", "3. More buildings: everything your builders finish counts, decorations too (roads don't).", "", "A Village's quests pay a quarter more, its caravans reach one more village and it can grow ten villagers bigger. Fireworks go up over the hall when it ranks up.", "", "This quest completes by itself when it happens, for the hall's owner and for anyone within 64 blocks of the hall."],
			dependencies: ["3C8F7F7EE3EF08EB"],
			icon: {id: "aliveworkplace:village_hall", count: 1},
			tasks: [{id: "13C933544EE70859", type: "advancement", advancement: "aliveworkplace:village/rank_village", criterion: ""}],
			rewards: [{id: "58FEC1BFB4226C8D", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}, {id: "19DEEEEBBD195402", type: "xp", xp: 200}]
		},
		{
			id: "2AA676DA8A58D35F",
			x: 6.0d,
			y: 0.0d,
			title: "The City Plan",
			description: ["Make a City Plan, your village's master plan.", "", "1. Craft a map, a Blank Blueprint and a Heart of the Sea together.", "2. Right-click your Village Hall with it: the plan is now that village's.", "3. Right-click the air to open it. Press + New to make a zone (homes, workshops, farms, the market...) and paint it on the grid.", "", "The plan tells the Steward (next quest) what to build where.", "", "This quest completes by itself as soon as you have a City Plan in your inventory."],
			dependencies: ["79EBDD6DE97214DD"],
			icon: {id: "aliveworkplace:city_plan", count: 1},
			tasks: [{id: "5DD47F0F4DC167A6", type: "item", item: {id: "aliveworkplace:city_plan", count: 1}}],
			rewards: [{id: "2AD2F7CF6BC5E948", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "4536CBF3BF2F6B2A",
			x: 9.0d,
			y: 0.0d,
			title: "Appoint a Steward",
			description: ["Make one of your builders the village's Steward.", "", "1. Pick a Builder of Journeyman level or higher (about 350 blocks of steady work). The hall's list of villagers shows each one's level.", "2. Bring him next to the Village Hall.", "3. Sneak-right-click him with the hall's City Plan. He changes into a clerk's long coat.", "", "The Steward plans the village and has the builders build it: homes when beds run short, a farm when food does.", "", "This quest completes by itself when it happens, for the hall's owner and for anyone within 64 blocks of the hall."],
			dependencies: ["2AA676DA8A58D35F"],
			icon: {id: "minecraft:writable_book", count: 1},
			tasks: [{id: "1284310662B8305C", type: "advancement", advancement: "aliveworkplace:village/steward", criterion: ""}],
			rewards: [{id: "64B26E13E3EB27D4", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 6}]
		},
		{
			id: "3960A49DE0FDF851",
			x: 12.0d,
			y: 0.0d,
			title: "The first festival",
			description: ["Hold your village's first festival.", "", "Every eight days, a village with a hall and at least six villagers holds a festival: a feast from the food store round the bell after work, music, dancing and fireworks at dusk.", "", "1. Open the Village Hall and hover over the firework rocket (Festival) in the second row: it says when the next one is.", "2. Can't wait? Carry a cake and click the firework rocket: the festival is held today or tomorrow (at most once every three days).", "", "Everyone who comes is in a better mood for two days.", "", "This quest completes by itself when it happens, for the hall's owner and for anyone within 64 blocks of the hall."],
			dependencies: ["4536CBF3BF2F6B2A"],
			icon: {id: "minecraft:cake", count: 1},
			tasks: [{id: "555B899C41225368", type: "advancement", advancement: "aliveworkplace:village/festival", criterion: ""}],
			rewards: [{id: "3C36CAE2C1BC686E", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "67AA0E243F95E6AA",
			x: 15.0d,
			y: 0.0d,
			title: "The first caravan",
			description: ["Send a caravan of supplies to another village.", "", "1. You need a second village with a Village Hall within 2048 blocks. No other village? Put a hall in one nearby, or start one with a Settler's Wagon.", "2. Open your Village Hall and click the minecart (Trade routes) in the second row.", "3. Click the other village in the list to send it caravans.", "", "Once a day a caravan takes that village what its workers are waiting for, from your Storehouse chests, always keeping 16 of everything for you.", "", "This quest completes by itself when your first caravan leaves, for the hall's owner and for anyone within 64 blocks of the hall."],
			dependencies: ["3960A49DE0FDF851"],
			icon: {id: "minecraft:chest_minecart", count: 1},
			tasks: [{id: "1CA9E2616B5BF69D", type: "advancement", advancement: "aliveworkplace:village/caravan", criterion: ""}],
			rewards: [{id: "2570C73883A4AA39", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "398FAF81FE717F9E",
			x: 18.0d,
			y: 0.0d,
			title: "Upgrades: Starter Cottage II",
			description: ["Upgrade your Starter Cottage: an upper story with a second bed.", "", "The Starter Cottage quest's reward put Starter Cottage II in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick Starter Cottage II and press Get Blueprint (it uses one Blank Blueprint).", "2. Right-click the finished Starter Cottage with it, without sneaking. The outline lines up exactly over the building.", "3. Hold Shift over the blueprint to see what it needs, and put it in chests within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with it. They only build what's new.", "", "Most buildings have bigger versions. A bed in a tier II building is a fine home, and villagers are happier for it. The reward puts Starter Cottage III in your Blueprint Table.", "", "This quest completes by itself when the builder finishes the Starter Cottage II."],
			dependencies: ["67AA0E243F95E6AA"],
			icon: {id: "aliveworkplace:blueprint", count: 1},
			tasks: [{id: "19F998DF9C731542", type: "advancement", advancement: "aliveworkplace:built/starter_cottage_2", criterion: ""}],
			rewards: [{id: "60796A0BF52F4045", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}, {id: "3A9FAC42E84FCDAC", type: "command", command: "/workplace unlock {p} aliveworkplace:starter_cottage_3", elevate_perms: true, silent: true}]
		},
		{
			id: "527BA8FAFB7389DE",
			x: 24.0d,
			y: 0.0d,
			title: "A Scholar: the Library",
			description: ["Build the Library and get a Scholar.", "", "1. Right-click the Blueprint Table, pick the Library and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. Stand a villager right next to the Library's lectern, hold paper and sneak-right-click the villager: they become a Scholar.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "Then sneak-right-click the scholar with an empty hand and click a topic to research. Keep paper, books and emeralds in a chest by the lectern: research costs them.", "", "Every level of research helps the whole village, and a Town needs 3 levels.", "", "This quest completes by itself when the builder finishes the Library."],
			dependencies: ["398FAF81FE717F9E"],
			icon: {id: "minecraft:lectern", count: 1},
			tasks: [{id: "2AC7A92F020125A6", type: "advancement", advancement: "aliveworkplace:built/library", criterion: ""}],
			rewards: [{id: "3C898FAE076FDF3F", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "259DA8A929FACABE",
			x: 27.0d,
			y: 0.0d,
			shape: "gear",
			size: 1.5d,
			title: "Three levels of research",
			description: ["Get 3 levels of research done.", "", "1. Keep the chest by the scholar's lectern stocked with paper, books and emeralds.", "2. When a topic is finished, sneak-right-click the scholar with an empty hand and pick the next one.", "3. To see how many levels are done, open the Village Hall and hover over the name tag at the top left. In the yellow line, the number in brackets after \"research\" is how many levels are done.", "", "A Town needs 20 villagers, 12 finished buildings and 3 levels of research, so keep building while the scholar works.", "", "This quest completes by itself when your scholars finish 3 levels of research."],
			dependencies: ["527BA8FAFB7389DE"],
			icon: {id: "minecraft:book", count: 1},
			tasks: [{id: "295A85D589AB6C24", type: "advancement", advancement: "aliveworkplace:village/research_3", criterion: ""}],
			rewards: [{id: "1E1A898AE5B1A26D", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 10}, {id: "31EC331943445C95", type: "xp", xp: 300}]
		},
		{
			id: "5E6AF9B44345583A",
			x: 0.0d,
			y: -2.0d,
			optional: true,
			title: "The treasury",
			description: ["Collect your village's takings.", "", "Every morning a working village puts some emeralds by: about a fifth of an emerald for each worker, a quarter more for each rank.", "", "1. Open the Village Hall and hover over the name tag at the top left: it says \"Treasury\" and how much is in it.", "2. Click the name tag to take the emeralds.", "", "The treasury holds only a stack of emeralds per rank, so collect it often.", "", "This quest completes by itself when you collect at least an emerald of takings."],
			dependencies: ["79EBDD6DE97214DD"],
			icon: {id: "minecraft:emerald", count: 1},
			tasks: [{id: "524C458E45CF2C7C", type: "advancement", advancement: "aliveworkplace:village/treasury", criterion: ""}],
			rewards: [{id: "2BB9BE247DEC6D5E", type: "xp", xp: 100}]
		},
		{
			id: "25A2A2033F63F536",
			x: 0.0d,
			y: 2.0d,
			optional: true,
			title: "A map of the village",
			description: ["Draw a map of your village at the hall.", "", "1. Carry an empty map.", "2. Open the Village Hall and click the filled map (Draw a map of the village) in the second row.", "", "The map shows every building your builders finished, each with a banner colored by what it is.", "", "Click the checkmark above once you've drawn the map."],
			dependencies: ["79EBDD6DE97214DD"],
			icon: {id: "minecraft:filled_map", count: 1},
			tasks: [{id: "505AADA9B92CA41B", type: "checkmark", title: "I drew a map of my village at the hall"}],
			rewards: [{id: "7084D495C9081999", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
		},
		{
			id: "1ABE635551D467C3",
			x: 9.0d,
			y: -2.0d,
			optional: true,
			title: "Approve a proposal",
			description: ["Approve one of the Steward's building plans.", "", "1. Open the Village Hall and click the compass (What next?). With a Steward it's his desk.", "2. Each morning he puts up proposals: the building, why (\"3 villagers have no bed\"), where, and what it needs.", "3. Click a proposal and press Approve. The builders build it.", "", "The Steward builds what the village needs most, where your City Plan says it should go.", "", "Click the checkmark above once you've approved a proposal."],
			dependencies: ["4536CBF3BF2F6B2A"],
			tasks: [{id: "13A770EBA9D75DB0", type: "checkmark", title: "I approved one of the Steward's proposals"}],
			rewards: [{id: "25D350DF667DF3B2", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "6C6E87DCA00BDF65",
			x: 9.0d,
			y: -4.0d,
			optional: true,
			title: "Roads",
			description: ["Have the Steward build a road.", "", "1. Open the City Plan (right-click the air with it) and pick the Road tool.", "2. Click points along the street and double-click to end it.", "3. The Steward has it laid, with lamps, steps, and bridges where it crosses water.", "", "Roads join your buildings up and make the village look planned.", "", "Click the checkmark above once a road from your plan has been built."],
			dependencies: ["1ABE635551D467C3"],
			tasks: [{id: "2AA71D00C42B06DF", type: "checkmark", title: "The Steward had a road built"}],
			rewards: [{id: "334FF36A8CEDA2BF", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "1940353CB7850488",
			x: 12.0d,
			y: -2.0d,
			optional: true,
			title: "Music: a Bandstand",
			description: ["Build the Bandstand and get a Bard.", "", "1. Right-click the Blueprint Table, pick the Bandstand and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. Stand a villager right next to the Bandstand's jukebox, hold a music disc and sneak-right-click the villager: they become a Bard.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "", "Its name is gray at the Blueprint Table at first: it's locked. Pick it there and the line under its name says how to get it.", "", "The Bard gives the village its music.", "", "This quest completes by itself when the builder finishes the Bandstand."],
			dependencies: ["3960A49DE0FDF851"],
			icon: {id: "minecraft:jukebox", count: 1},
			tasks: [{id: "65B0ED600A29DDE6", type: "advancement", advancement: "aliveworkplace:built/bandstand", criterion: ""}],
			rewards: [{id: "13E45228AD47C319", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "2D8B0AB058176FAE",
			x: 15.0d,
			y: -2.0d,
			optional: true,
			title: "Mail: a Post Office",
			description: ["Build the Post Office and get a Postman.", "", "1. Right-click the Blueprint Table, pick the Post Office and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. Stand a villager right next to the Post Office's Mailbox, hold paper and sneak-right-click the villager: they become a Postman.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "", "The postman carries parcels and letters between players' Mailboxes.", "", "This quest completes by itself when the builder finishes the Post Office."],
			dependencies: ["67AA0E243F95E6AA"],
			icon: {id: "aliveworkplace:mailbox", count: 1},
			tasks: [{id: "56DFF3471EBB6D59", type: "advancement", advancement: "aliveworkplace:built/post_office", criterion: ""}],
			rewards: [{id: "59A6F7F07A7F2115", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "7D91C0088B4EB222",
			x: 15.0d,
			y: 2.0d,
			optional: true,
			title: "The Trainer Leader",
			description: ["Make and beat your village's Trainer Leader.", "", "1. Stand a villager next to a Training Post, hold a block of gold and sneak-right-click them: they become the Trainer Leader.", "2. Right-click the leader with an empty hand to battle.", "", "A leader battles at Expert strength and pays three times a trainer's prize, one challenge a day for each player.", "", "Click the checkmark above once you've beaten a Trainer Leader."],
			dependencies: ["67AA0E243F95E6AA"],
			tasks: [{id: "62999B292CD871EB", type: "checkmark", title: "I beat a Trainer Leader"}],
			rewards: [{id: "74690A59CAD40905", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}]
		},
		{
			id: "1F762CC1FC4733C6",
			x: 18.0d,
			y: -2.0d,
			optional: true,
			title: "Stone House II",
			description: ["Upgrade your Stone House with a timber-framed upper story.", "", "The Stone House quest's reward put Stone House II in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick Stone House II and press Get Blueprint (it uses one Blank Blueprint).", "2. Right-click the finished Stone House with it, without sneaking. The outline lines up exactly over the building.", "3. Hold Shift over the blueprint to see what it needs, and put it in chests within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with it. They only build what's new.", "", "Its beds are fine homes. The reward puts Stone House III in your Blueprint Table.", "", "This quest completes by itself when the builder finishes the Stone House II."],
			dependencies: ["398FAF81FE717F9E"],
			tasks: [{id: "3D5228501E6FF757", type: "advancement", advancement: "aliveworkplace:built/stone_house_2", criterion: ""}],
			rewards: [{id: "501B6A5BD84CEACC", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}, {id: "1976E32A14DA7DDB", type: "command", command: "/workplace unlock {p} aliveworkplace:stone_house_3", elevate_perms: true, silent: true}]
		},
		{
			id: "17FD976B22857B0F",
			x: 3.0d,
			y: -2.0d,
			optional: true,
			title: "Village Hall II",
			description: ["Give your hall a meeting room, with a council table and bookshelves.", "", "The Village Hall quest's reward put Village Hall II in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick Village Hall II and press Get Blueprint (it uses one Blank Blueprint).", "2. Right-click the finished Village Hall with it, without sneaking. The outline lines up exactly over the building.", "3. Hold Shift over the blueprint to see what it needs, and put it in chests within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with it. They only build what's new.", "", "The Village Hall block stays where it is while they build, so the village never loses its hall. The reward puts Village Hall III in your Blueprint Table.", "", "This quest completes by itself when the builder finishes the Village Hall II."],
			dependencies: ["79EBDD6DE97214DD"],
			icon: {id: "aliveworkplace:village_hall", count: 1},
			tasks: [{id: "48144CEE592EBE31", type: "advancement", advancement: "aliveworkplace:built/village_hall_2", criterion: ""}],
			rewards: [{id: "1B04104ABFBAAF63", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}, {id: "4CF828B6AEF40761", type: "command", command: "/workplace unlock {p} aliveworkplace:village_hall_3", elevate_perms: true, silent: true}]
		},
		{
			id: "52FC6119EC326638",
			x: 3.0d,
			y: -4.0d,
			optional: true,
			title: "Village Hall III",
			description: ["Crown your hall with a stone tower, a clock and a great bell.", "", "The Village Hall II quest's reward put Village Hall III in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick Village Hall III and press Get Blueprint (it uses one Blank Blueprint).", "2. Right-click the finished Village Hall II with it, without sneaking. The outline lines up exactly over the building.", "3. Hold Shift over the blueprint to see what it needs, and put it in chests within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with it. They only build what's new.", "", "The grandest hall there is: everyone nearby will know where your village's heart is.", "", "This quest completes by itself when the builder finishes the Village Hall III."],
			dependencies: ["17FD976B22857B0F"],
			icon: {id: "minecraft:bell", count: 1},
			tasks: [{id: "64DD693FFEFE9485", type: "advancement", advancement: "aliveworkplace:built/village_hall_3", criterion: ""}],
			rewards: [{id: "2FB0B91097264706", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 5}]
		},
		{
			id: "1A458BABF75611C3",
			x: 18.0d,
			y: 2.0d,
			optional: true,
			title: "Terrace II",
			description: ["Add a third home to your Terrace: six beds in all.", "", "The Terrace quest's reward put Terrace II in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick Terrace II and press Get Blueprint (it uses one Blank Blueprint).", "2. Right-click the finished Terrace with it, without sneaking. The outline lines up exactly over the building.", "3. Hold Shift over the blueprint to see what it needs, and put it in chests within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with it. They only build what's new.", "", "Two more beds, and fine homes for the families in them.", "", "This quest completes by itself when the builder finishes the Terrace II."],
			dependencies: ["398FAF81FE717F9E"],
			tasks: [{id: "6D2F0743444EB175", type: "advancement", advancement: "aliveworkplace:built/terrace_2", criterion: ""}],
			rewards: [{id: "14C9063ADE892A73", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "41130BF40F4D9235",
			x: 24.0d,
			y: -2.0d,
			optional: true,
			title: "A Teacher: the Schoolhouse",
			description: ["Build the Schoolhouse and get a Teacher.", "", "1. Right-click the Blueprint Table, pick the Schoolhouse and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. Stand a villager right next to the Schoolhouse's lectern, hold a book and sneak-right-click the villager: they become a Teacher.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "", "Its name is gray at the Blueprint Table at first: it's locked. Pick it there and the line under its name says how to get it.", "", "Children who go to the Teacher's lessons start their first job a level up.", "", "This quest completes by itself when the builder finishes the Schoolhouse."],
			dependencies: ["527BA8FAFB7389DE"],
			icon: {id: "minecraft:book", count: 1},
			tasks: [{id: "727E4F49B7D7FB0E", type: "advancement", advancement: "aliveworkplace:built/schoolhouse", criterion: ""}],
			rewards: [{id: "5B0C3E3A027BB3B1", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "4F4F6280B6BD49CA",
			x: 24.0d,
			y: 2.0d,
			optional: true,
			title: "A Nurse: the Clinic",
			description: ["Build the Clinic and get a Nurse.", "", "1. Right-click the Blueprint Table, pick the Clinic and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. Stand a villager right next to the Clinic's brewing stand, hold a honey bottle and sneak-right-click the villager: they become a Nurse.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "", "The nurse cures the village's sick with honey bottles from the chest by the brewing stand, and heals you when you right-click them with an empty hand.", "", "This quest completes by itself when the builder finishes the Clinic."],
			dependencies: ["527BA8FAFB7389DE"],
			icon: {id: "minecraft:honey_bottle", count: 1},
			tasks: [{id: "5A96266DD31B5A8C", type: "advancement", advancement: "aliveworkplace:built/clinic", criterion: ""}],
			rewards: [{id: "53D1FFB4D195D9AF", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
