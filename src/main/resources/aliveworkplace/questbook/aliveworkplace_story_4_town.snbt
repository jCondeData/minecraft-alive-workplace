	quests: [
		{
			id: "763B30CC4AA2D061",
			x: 0.0d,
			y: 0.0d,
			title: "A Town",
			description: ["20 villagers, 12 finished buildings and 3 levels of research make a Town. Every rank makes quests pay more, brings a third trader to market and lets the village grow ten villagers bigger.", "", "Hover over the hall's name icon to see what's still missing. This ticks off by itself."],
			dependencies: ["259DA8A929FACABE"],
			icon: {id: "aliveworkplace:village_hall", count: 1},
			tasks: [{id: "5D89A70FC4EA24ED", type: "advancement", advancement: "aliveworkplace:village/rank_town", criterion: ""}],
			rewards: [{id: "45BF958E486BC43C", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 16}, {id: "2D09E907EC3E0310", type: "xp", xp: 300}, {id: "75B18CF99D4E9E94", type: "command", command: "/workplace unlock {p} aliveworkplace:barracks", elevate_perms: true, silent: true}]
		},
		{
			id: "5F80C395E9618060",
			x: 3.0d,
			y: 0.0d,
			title: "Guards: the Barracks",
			description: ["A bigger village draws bigger raids: 3 raiders, plus one for every 4 villagers. Build the Barracks, with two grindstones and two bunks. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it. A build shown greyed out at the Table isn't unlocked yet: the Table says how to get it.", "", "Sneak-right-click a villager by each grindstone holding a sword: they become Guards."],
			dependencies: ["763B30CC4AA2D061"],
			icon: {id: "minecraft:grindstone", count: 1},
			tasks: [{id: "3D2F8DF9389527BD", type: "advancement", advancement: "aliveworkplace:built/barracks", criterion: ""}],
			rewards: [{id: "3E561C640A808252", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}, {id: "3A58970668DB9D2E", type: "command", command: "/workplace unlock {p} aliveworkplace:gatehouse", elevate_perms: true, silent: true}]
		},
		{
			id: "7ED000369F90D1EA",
			x: 6.0d,
			y: 0.0d,
			title: "Walls: the Gatehouse",
			description: ["Build a wall round the village with the Stone Wall, Wall Tower and Gatehouse blueprints. Place the Gatehouse in a line of Stone Walls where the road comes in, facing out. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it. A build shown greyed out at the Table isn't unlocked yet: the Table says how to get it.", "", "In a village with a hall and at least one guard, its gates are shut at nightfall and opened in the morning. This ticks off when the Gatehouse is finished."],
			dependencies: ["5F80C395E9618060"],
			icon: {id: "minecraft:stone_bricks", count: 1},
			tasks: [{id: "2F55695A24FD199C", type: "advancement", advancement: "aliveworkplace:built/gatehouse", criterion: ""}],
			rewards: [{id: "279EC24AEFF2F026", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "6597AAE5BFDC3678",
			x: 9.0d,
			y: 0.0d,
			title: "Survive a raid",
			description: ["A village with a hall and at least 8 villagers may be raided at night: the bell rings, the guards rally and everyone else hides. The raid ends when the raiders are dead, or at dawn, when they flee.", "", "Keep your villagers safe until it's over. This ticks off by itself."],
			dependencies: ["7ED000369F90D1EA"],
			icon: {id: "minecraft:shield", count: 1},
			tasks: [{id: "4C2C9860F2DC080B", type: "advancement", advancement: "aliveworkplace:village/raid", criterion: ""}],
			rewards: [{id: "136267B30034A7D8", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 6}, {id: "68F050F09930773D", type: "xp", xp: 200}]
		},
		{
			id: "152E6CF8FF955275",
			x: 12.0d,
			y: 0.0d,
			title: "The Guild Charter",
			description: ["3 paper, an emerald, a gold ingot and red dye make a Guild Charter. Sneak-right-click a Master with it to start a guild of their trade."],
