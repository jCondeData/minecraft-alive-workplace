{
	id: "68EC9D2CD3151391",
	group: "",
	order_index: 102,
	filename: "aliveworkplace_03_jobs",
	title: "Hiring and Retraining",
	subtitle: ["Every job has a building: build it and a worker moves in"],
	icon: {id: "aliveworkplace:storehouse", count: 1},
	default_quest_shape: "",
	default_hide_dependency_lines: false,
	quests: [
		{
			id: "5FEAB93EEF736663",
			x: 0.0d,
			y: 0.0d,
			title: "Pick a job",
			description: ["Every job below has a building in the Blueprint Table with its workstation inside. Build it and a villager can live and work there; each quest ticks off when its building is finished.", "", "Vanilla jobs work as in vanilla: a villager without a job takes the block by themselves. Most of our jobs share a vanilla block: stand the villager within about 4 blocks of it and sneak-right-click them holding the job's item, a pickaxe at a Blast Furnace for a Miner, an axe at a Fletching Table for a Lumberjack.", "", "Hold Shift over a workstation in your inventory to see every job it gives and the item for each."],
			dependencies: ["694682BB5A92E7B1"],
			tasks: [{id: "5706D753AECBB4A3", type: "checkmark", title: "I gave a villager one of the new jobs"}],
			rewards: [{id: "68FD7B4E92911EFC", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "764D63D279D7BECE",
			x: 3.0d,
			y: -6.0d,
			title: "Retrain a villager",
			description: ["In a busy village almost everyone already works. You can retrain any grown villager who has a job (not a child or a nitwit).", "", "Stand them within about 4 blocks of one of our job blocks, like the Blueprint Table, and sneak-right-click them holding the new job's item. You're shown the price: 5 emeralds for a Novice, up to 50 for a Master. Click again within a few seconds to pay.", "", "Their old trades and level are lost, and they start the new job as a Novice."],
			dependencies: ["5FEAB93EEF736663"],
			tasks: [{id: "4CD4FE932C9B7A59", type: "checkmark", title: "I retrained a villager"}],
			rewards: [{id: "3BA0C98A0B8C563A", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 5}]
		},
		{
			id: "5007642FFF4DACC0",
			x: 3.0d,
			y: -4.0d,
			title: "Hire a vanilla worker",
			description: ["Picking a job isn't hiring. A vanilla worker whose job we've extended (an Armorer, a Toolsmith...) is hired with that job's item: hired, they work with your own workers; unhired, they work for their village."],
			dependencies: ["5FEAB93EEF736663"],
			tasks: [{id: "1F9D09040DE103F9", type: "checkmark", title: "I hired a vanilla worker"}],
			rewards: [{id: "71A652142345953D", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
		},
		{
			id: "7F72A885171E7D72",
			x: 3.0d,
			y: -2.0d,
			title: "The Porter: a Storehouse",
			description: ["Build the Storehouse: a granary with a Storehouse block and eight chests. A villager without a job takes the Storehouse by themselves and becomes a Porter, who walks round the other workers and carries what they make to the store.", "", "The Storehouse block on its own: three planks on top, then a barrel, a chest and a barrel."],
			dependencies: ["5FEAB93EEF736663"],
			icon: {id: "aliveworkplace:storehouse", count: 1},
			tasks: [{id: "2E7F0777E2F565E5", type: "advancement", advancement: "aliveworkplace:built/storehouse", criterion: ""}],
			rewards: [{id: "1286246FD67E028E", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "398D9AE65D91997C",
			x: 3.0d,
			y: 0.0d,
			title: "The Farmer: a Farmstead",
			description: ["Build the Farmstead: a farmhouse beside a field round a water channel, with a composter. A villager without a job takes the composter and farms the field.", "", "A stick, wheat seeds and paper make a Field Marker, to hand a worker more land to look after."],
			dependencies: ["5FEAB93EEF736663"],
			icon: {id: "aliveworkplace:field_marker", count: 1},
			tasks: [{id: "59D81BD214D6E199", type: "advancement", advancement: "aliveworkplace:built/farmstead", criterion: ""}],
			rewards: [{id: "6404D5633CBE8977", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "703E70201DACFC60",
			x: 3.0d,
			y: 2.0d,
			title: "The Miner: a Smithy",
			description: ["The Miner has no table of their own: they work at a Blast Furnace. Build the Smithy, a stone forge with a blast furnace, a smithing table and a grindstone, and sneak-right-click a villager by the blast furnace holding a pickaxe.", "", "A stick, red dye and paper make a Quarry Marker: it tells the miner where to dig, and they fill your chests layer by layer. A villager given coal there becomes an Armorer instead."],
			dependencies: ["5FEAB93EEF736663"],
			icon: {id: "aliveworkplace:quarry_marker", count: 1},
			tasks: [{id: "64AF859281C5DE7D", type: "advancement", advancement: "aliveworkplace:built/smithy", criterion: ""}],
			rewards: [{id: "4C48CD909852AF18", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "1F6C818E31AC5BC3",
			x: 3.0d,
			y: 4.0d,
			title: "The Carpenter: a Carpenter's Workshop",
			description: ["The Carpenter has no table of their own: they work at a crafting table. Build the Carpenter's Workshop, a little house with a crafting table, and sneak-right-click a villager by it holding planks.", "", "When a build is short of something that can be crafted (doors, stairs, fences...), the carpenter makes it, so your builders wait less."],
			dependencies: ["5FEAB93EEF736663"],
			icon: {id: "minecraft:crafting_table", count: 1},
			tasks: [{id: "51787ED7EB380C9E", type: "advancement", advancement: "aliveworkplace:built/carpenters_workshop", criterion: ""}],
			rewards: [{id: "271C04CE1E29A624", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "7B598D67C34910EC",
			x: 6.0d,
			y: 9.0d,
			title: "A second builder: the Builder's Workshop",
			description: ["A home and a workshop for one more builder: a bed, a crafting table, a chest and a Blueprint Table. A villager without a job takes the table and joins your crew."],
			dependencies: ["1F6C818E31AC5BC3"],
			icon: {id: "aliveworkplace:blueprint_table", count: 1},
