		{
			id: "51FBBEF686C11029",
			x: 3.0d,
			y: -2.0d,
			optional: true,
			title: "A guard before the first raid",
			description: ["Monsters raid at night once a village with a hall has 8 villagers. Build the Guard House, a little house with a grindstone. Get its blueprint at the Blueprint Table (pick it, press Get Blueprint: it takes a Blank Blueprint), right-click the ground where its front goes, stock the chests within 8 blocks of the table with what the blueprint lists when you hold Shift over it, and right-click your builder with it. A build shown greyed out at the Table isn't unlocked yet: the Table says how to get it.", "", "Sneak-right-click a villager by the grindstone holding a sword: they become a Guard."],
			dependencies: ["27FFFFBF2277B6E3"],
			icon: {id: "minecraft:iron_sword", count: 1},
