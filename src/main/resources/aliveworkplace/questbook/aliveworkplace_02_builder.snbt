	quests: [
		{
			id: "694682BB5A92E7B1",
			x: 0.0d,
			y: 0.0d,
			title: "Build a Starter Cottage",
			subtitle: "Your first home, and the start of a village",
			description: ["The Starter Cottage is a little timber cottage with a bed: your village's first home. A villager moves into its bed, and every home you build after it lets the village grow. Everything else starts here.", "", "1. Craft a Blueprint Table (blue dye on top, a cartography table in the middle with planks on each side, planks in the two bottom corners). Put it down near a villager without a job: they take it and become a Builder.", "2. Paper and blue dye make two Blank Blueprints. At the Blueprint Table, pick the Starter Cottage and press Get Blueprint. (A Novice builder also sells it, for 6 emeralds.)", "3. Hold the blueprint and right-click the ground where the front should go: the gold edge is the front.", "4. Fill chests or barrels within 8 blocks of the Blueprint Table with what the blueprint lists when you hold Shift over it.", "5. Right-click the builder with the blueprint. This quest ticks off when the cottage is finished.", "", "What the builder is doing, or waiting for, floats over their head."],
			dependencies: [],
			icon: {id: "aliveworkplace:blueprint", count: 1},
			tasks: [{id: "52D13925B96595C9", type: "advancement", advancement: "aliveworkplace:built/starter_cottage", criterion: ""}],
			rewards: [{id: "5373C57F71A8A938", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 5}, {id: "2D0998A870096EF6", type: "xp", xp: 150}, {id: "37883452EF0B7726", type: "command", command: "/workplace unlock {p} aliveworkplace:starter_cottage_2", elevate_perms: true, silent: true}]
		},
		{
			id: "197D0F50A19AD1DB",
			x: 3.0d,
			y: -6.0d,
			title: "Starter Cottage II",
			description: ["Most buildings have a bigger version. Once a builder finishes one, they sell its upgrade. Finishing the cottage put Starter Cottage II in your village's Blueprint Table.", "", "Right-click the finished cottage with the Starter Cottage II blueprint: it lines up exactly over it, and the builder only builds what's new, an upper story with a second bed. A bed in a tier II building counts as a fine home, which makes the villagers who sleep there happier."],
			dependencies: ["694682BB5A92E7B1"],
			tasks: [{id: "5E75EB8375C30104", type: "advancement", advancement: "aliveworkplace:built/starter_cottage_2", criterion: ""}],
