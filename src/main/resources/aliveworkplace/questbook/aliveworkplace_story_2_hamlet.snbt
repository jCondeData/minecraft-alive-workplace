			optional: true,
			title: "A Training Dummy",
			description: ["Wool on top, a hay bale with a stick on each side and a stick underneath make a Training Dummy for your guards to practice on."],
			dependencies: ["51FBBEF686C11029"],
			icon: {id: "aliveworkplace:training_dummy", count: 1},
