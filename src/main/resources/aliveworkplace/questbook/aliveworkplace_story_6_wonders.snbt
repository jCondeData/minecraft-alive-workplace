	quests: [
		{
			id: "68A2DAE827EDA936",
			x: 0.0d,
			y: 0.0d,
			title: "A Wonder Plan",
			description: ["Get the plans for a Wonder, a village's greatest build.", "", "1. Open the Village Hall and click the Wonders button (a rolled plan) in the row of page buttons.", "2. Each Wonder's card lists what it needs, each line ticked or crossed. Every Wonder needs a Town, the Master Architect and one more Legend of its own (or the villager who stands in for them).", "3. When every line is ticked, click the card: 32 emeralds buy a Wonder Plan, from the treasury if it has them.", "", "A Town can raise one Wonder and a City two, each in four stages. The side quests say what each Wonder needs.", "", "This quest completes by itself as soon as you have a Wonder Plan in your inventory."],
			dependencies: ["5494189D8D643C66"],
			icon: {id: "aliveworkplace:wonder_plan", count: 1},
			tasks: [{id: "33C3CCB7DBAC614D", type: "item", item: {id: "aliveworkplace:wonder_plan", count: 1}}],
			rewards: [{id: "78DD4DB0DDDFA424", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}]
		},
		{
			id: "22CB6180B1FE917C",
			x: 3.0d,
			y: 0.0d,
			title: "Your first Wonder",
			description: ["Raise your first Wonder.", "", "1. Hold the Wonder Plan and right-click the ground to place it, its middle within 64 blocks of the hall.", "2. Right-click one of the village's builders with it: a Foundation Stone goes down by its front corner.", "3. Stock the chests within 8 blocks of the stone. Right-click the stone to see what the current stage is still short of, including the rare things found by exploring.", "4. Every builder with nothing else to do joins the crew.", "", "When it's finished, the whole server hears of it and the village holds a festival.", "", "This quest completes by itself when the Wonder is finished, for the hall's owner and for anyone within 64 blocks of the hall."],
			dependencies: ["68A2DAE827EDA936"],
			icon: {id: "minecraft:beacon", count: 1},
			tasks: [{id: "115BE2820F286487", type: "advancement", advancement: "aliveworkplace:village/wonder", criterion: ""}],
			rewards: [{id: "13460A4E5E0F5FBD", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 32}, {id: "1D5CD056511B62F9", type: "xp", xp: 500}]
		},
		{
			id: "66E8E9B463AC77AA",
			x: 15.0d,
			y: 0.0d,
			shape: "gear",
			size: 1.5d,
			title: "Every Wonder",
			description: ["Raise every Wonder across your villages.", "", "A village can raise one of each kind: a Town one Wonder, a City two. Your other villages and colonies can raise the rest.", "", "Each Wonder changes what its village, or its whole realm, can do.", "", "Click the checkmark above once your villages have raised every Wonder."],
			dependencies: ["22CB6180B1FE917C"],
			icon: {id: "minecraft:nether_star", count: 1},
			tasks: [{id: "3CC67B0AF9FDF121", type: "checkmark", title: "My villages raised every Wonder"}],
			rewards: [{id: "47CE77AE98919313", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 64}, {id: "39A67F886E91A3EB", type: "xp", xp: 1000}]
		},
		{
			id: "5A79478F7F69A725",
			x: 3.0d,
			y: -2.0d,
			optional: true,
			title: "The Great Cathedral",
			description: ["Raise the Great Cathedral.", "", "It needs a Town, the Master Architect, the Seer (or a Master Cleric) and 3 finished Chapels.", "", "To raise it: on the hall's Wonders page, click its card once every line is ticked, then build it as in \"Your first Wonder\". A village raises one Wonder at a time.", "", "While it stands, the village's Undertaker brings anyone lying in a grave at dawn back in the night, and weddings at its altar are blessed.", "", "Click the checkmark above once your village has raised the Great Cathedral."],
			dependencies: ["22CB6180B1FE917C"],
			tasks: [{id: "74F7EA3827AA44F7", type: "checkmark", title: "My village raised the Great Cathedral"}],
			rewards: [{id: "515E03D236892B86", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 16}]
		},
		{
			id: "21C627C2812A5FD1",
			x: 3.0d,
			y: 2.0d,
			optional: true,
			title: "The Lighthouse",
			description: ["Raise the Lighthouse.", "", "It needs a Town on the coast, the Master Architect, and the Merchant Prince (or 3 caravan routes).", "", "To raise it: on the hall's Wonders page, click its card once every line is ticked, then build it as in \"Your first Wonder\". A village raises one Wonder at a time.", "", "While it stands, the village's caravans reach twice as far in half the time, and ferry fares are halved.", "", "Click the checkmark above once your village has raised the Lighthouse."],
			dependencies: ["22CB6180B1FE917C"],
			tasks: [{id: "6D6676FAB0269423", type: "checkmark", title: "My village raised the Lighthouse"}],
			rewards: [{id: "3CCEA660A95869B6", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 16}]
		},
		{
			id: "64CE55FD11B4E07B",
			x: 6.0d,
			y: -2.0d,
			optional: true,
			title: "The Great Library",
			description: ["Raise the Great Library.", "", "It needs a Town, the Master Architect, the Old Sage (or a Master Scholar) and 20 research levels.", "", "To raise it: on the hall's Wonders page, click its card once every line is ticked, then build it as in \"Your first Wonder\". A village raises one Wonder at a time.", "", "While it stands, the scholars can research a second tier of topics.", "", "Click the checkmark above once your village has raised the Great Library."],
			dependencies: ["22CB6180B1FE917C"],
			tasks: [{id: "4CACBCA11510BAAA", type: "checkmark", title: "My village raised the Great Library"}],
			rewards: [{id: "109D02C5025FB5DC", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 16}]
		},
		{
			id: "61B2F0917D5EB34C",
			x: 6.0d,
			y: 2.0d,
			optional: true,
			title: "The Great Wall",
			description: ["Raise the Great Wall.", "", "It needs a Town, the Master Architect, a finished Gatehouse, and the Golem Smith (or 4 iron golems and a Master Tinkerer).", "", "To raise it: on the hall's Wonders page, click its card once every line is ticked, then build it as in \"Your first Wonder\". A village raises one Wonder at a time.", "", "While it stands, no raid gathers behind it: raiders have to come from the open side, and iron golems keep its walk.", "", "Click the checkmark above once your village has raised the Great Wall."],
			dependencies: ["22CB6180B1FE917C"],
			tasks: [{id: "2E5F633D9CF1C273", type: "checkmark", title: "My village raised the Great Wall"}],
			rewards: [{id: "4DC5A74B96F5C2B0", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 16}]
		},
		{
			id: "395351613EF05A88",
			x: 9.0d,
			y: -2.0d,
			optional: true,
			title: "The Observatory",
			description: ["Raise the Observatory and draw its Sky Chart.", "", "It needs a Town, the Master Architect and the Seer (or a Master Cleric).", "", "To raise it: on the hall's Wonders page, click its card once every line is ticked, then build it as in \"Your first Wonder\". A village raises one Wonder at a time.", "", "Once it stands, carry two empty maps and click the filled map (Draw a map of the village) on the hall: the second map becomes the Sky Chart, with the places the Observatory found around the village.", "", "Click the checkmark above once the Observatory stands and you've drawn the Sky Chart."],
			dependencies: ["22CB6180B1FE917C"],
			icon: {id: "minecraft:filled_map", count: 1},
			tasks: [{id: "605CDA979E6497E4", type: "checkmark", title: "My village raised the Observatory, and I drew the Sky Chart"}],
			rewards: [{id: "5C9F99672C2765F3", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 16}]
		},
		{
			id: "1A3F0901DEF3A9D8",
			x: 9.0d,
			y: 2.0d,
			optional: true,
			title: "The Hanging Gardens",
			description: ["Raise the Hanging Gardens.", "", "It needs a Town, the Master Architect, and the Grand Chef (or a Master Chef and 8 kinds of meal in the food store).", "", "To raise it: on the hall's Wonders page, click its card once every line is ticked, then build it as in \"Your first Wonder\". A village raises one Wonder at a time.", "", "While it stands, farmers and orchard keepers across the realm harvest a quarter more, and the village grows faster.", "", "Click the checkmark above once your village has raised the Hanging Gardens."],
			dependencies: ["22CB6180B1FE917C"],
			tasks: [{id: "50BE62BC33C7D5D3", type: "checkmark", title: "My village raised the Hanging Gardens"}],
			rewards: [{id: "48C99BF54F99167C", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 16}]
		},
		{
			id: "2F110C620F31D940",
			x: 12.0d,
			y: -2.0d,
			optional: true,
			title: "The Colossus",
			description: ["Raise the Colossus.", "", "It needs a City, the Master Architect and the Founder.", "", "To raise it: on the hall's Wonders page, click its card once every line is ticked, then build it as in \"Your first Wonder\". A village raises one Wonder at a time.", "", "While it stands, the whole realm is happier, and travelers come to its inns twice as often.", "", "Click the checkmark above once your village has raised the Colossus."],
			dependencies: ["22CB6180B1FE917C"],
