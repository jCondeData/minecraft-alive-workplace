{
	"schemaVersion": 1,
	"id": "aliveworkplace",
	"version": "${version}",
	"name": "Alive Workplace",
	"description": "Villagers with real jobs. Hand a Builder a blueprint and they build it — fetching materials from chests, clearing the site and placing every block.",
	"authors": ["jCondeData"],
	"contact": {
		"homepage": "https://github.com/jCondeData/minecraft-alive-workplace",
		"sources": "https://github.com/jCondeData/minecraft-alive-workplace",
		"issues": "https://github.com/jCondeData/minecraft-alive-workplace/issues"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/aliveworkplace/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["io.github.jcondedata.aliveworkplace.platform.fabric.AliveWorkplaceFabric"],
		"client": ["io.github.jcondedata.aliveworkplace.client.AliveWorkplaceClient"],
		"modmenu": ["io.github.jcondedata.aliveworkplace.client.compat.ModMenuEntry"]
	},
	"mixins": ["aliveworkplace.mixins.json", {"config": "aliveworkplace.client.mixins.json", "environment": "client"}],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"suggests": {
		"cobblemon": "*",
		"cobbledollars": "*",
		"rctmod": "*",
		"mega_showdown": "*",
		"modmenu": "*"
	}
}
