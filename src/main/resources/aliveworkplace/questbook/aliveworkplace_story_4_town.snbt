{
	id: "1E5C2FF56CE2800A",
	group: "",
	order_index: 103,
	filename: "aliveworkplace_story_4_town",
	title: "4. A Town",
	subtitle: ["Walls and guards, a raid survived, guilds, edicts and Legends"],
	icon: {id: "minecraft:iron_sword", count: 1},
	default_quest_shape: "",
	default_hide_dependency_lines: false,
	quests: [
		{
			id: "763B30CC4AA2D061",
			x: 0.0d,
			y: 0.0d,
			title: "A Town",
			description: ["Grow your Village into a Town: 20 villagers, 12 finished buildings and 3 levels of research.", "", "1. Open the Village Hall (right-click it) and hover over the name tag at the top left: the yellow line says what the next rank still needs.", "2. Keep building houses for more villagers, and anything else for more buildings.", "3. Keep your scholar researching.", "", "A Town's quests pay more, a third trader comes on market day and it can grow ten villagers bigger.", "", "This quest completes by itself when it happens, for the hall's owner and for anyone within 64 blocks of the hall."],
			dependencies: ["259DA8A929FACABE"],
			icon: {id: "aliveworkplace:village_hall", count: 1},
			tasks: [{id: "5D89A70FC4EA24ED", type: "advancement", advancement: "aliveworkplace:village/rank_town", criterion: ""}],
			rewards: [{id: "45BF958E486BC43C", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 16}, {id: "2D09E907EC3E0310", type: "xp", xp: 300}, {id: "75B18CF99D4E9E94", type: "command", command: "/workplace unlock {p} aliveworkplace:barracks", elevate_perms: true, silent: true}]
		},
		{
			id: "5F80C395E9618060",
			x: 3.0d,
			y: 0.0d,
			title: "Guards: the Barracks",
			description: ["Build the Barracks, with two grindstones and two bunks, and fill it with guards.", "", "The reward of the last quest (A Town) put it in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick the Barracks and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "5. Stand a villager right next to the grindstone, hold a sword and sneak-right-click the villager: they become a Guard.", "A villager who already took another job at that block works too: sneak-right-click them the same way.", "Do this at each of its two grindstones.", "", "Bigger villages draw bigger raids: 3 raiders, plus one for every 4 villagers.", "", "This quest completes by itself when the builder finishes the Barracks."],
			dependencies: ["763B30CC4AA2D061"],
			icon: {id: "minecraft:grindstone", count: 1},
			tasks: [{id: "3D2F8DF9389527BD", type: "advancement", advancement: "aliveworkplace:built/barracks", criterion: ""}],
			rewards: [{id: "3E561C640A808252", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}, {id: "3A58970668DB9D2E", type: "command", command: "/workplace unlock {p} aliveworkplace:gatehouse", elevate_perms: true, silent: true}]
		},
		{
			id: "7ED000369F90D1EA",
			x: 6.0d,
			y: 0.0d,
			title: "Walls: the Gatehouse",
			description: ["Build a Gatehouse where the road comes into your village.", "", "The reward of the last quest (Guards: the Barracks) put it in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick the Gatehouse and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "", "Place it facing out, where the road comes in; the Stone Wall and Wall Tower blueprints make the rest of the wall. In a village with a hall and at least one guard, its gates shut at nightfall and open in the morning.", "", "This quest completes by itself when the builder finishes the Gatehouse."],
			dependencies: ["5F80C395E9618060"],
			icon: {id: "minecraft:stone_bricks", count: 1},
			tasks: [{id: "2F55695A24FD199C", type: "advancement", advancement: "aliveworkplace:built/gatehouse", criterion: ""}],
			rewards: [{id: "279EC24AEFF2F026", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 4}]
		},
		{
			id: "6597AAE5BFDC3678",
			x: 9.0d,
			y: 0.0d,
			title: "Survive a raid",
			description: ["Get your village through a night raid.", "", "A village with a hall and at least 8 villagers may be raided at night. When it starts, the bell rings, the guards rally and everyone else hides.", "", "1. Help your guards fight the raiders off.", "2. The raid ends when the raiders are all dead, or at dawn, when the rest flee.", "", "Short of guards? The iron sword (Hire mercenaries) in the hall's second row hires fighters until dawn.", "", "This quest completes by itself when a raid is over, for the hall's owner and for anyone within 64 blocks of the hall."],
			dependencies: ["7ED000369F90D1EA"],
			icon: {id: "minecraft:shield", count: 1},
			tasks: [{id: "4C2C9860F2DC080B", type: "advancement", advancement: "aliveworkplace:village/raid", criterion: ""}],
			rewards: [{id: "136267B30034A7D8", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 6}, {id: "68F050F09930773D", type: "xp", xp: 200}]
		},
		{
			id: "152E6CF8FF955275",
			x: 12.0d,
			y: 0.0d,
			title: "The Guild Charter",
			description: ["Make a Guild Charter, to start a guild.", "", "1. Craft 3 paper, an emerald, a gold ingot and red dye together.", "2. Sneak-right-click a Master villager (top level) with it: they become the Guild Master of their trade's guild.", "", "A guild makes everyone of that trade work better, once it has a Guildhall (next quest). Your village needs Village rank for its first guild.", "", "This quest completes by itself as soon as you have a Guild Charter in your inventory."],
			dependencies: ["6597AAE5BFDC3678"],
			icon: {id: "aliveworkplace:guild_charter", count: 1},
			tasks: [{id: "3A69000FB6889E04", type: "item", item: {id: "aliveworkplace:guild_charter", count: 1}}],
			rewards: [{id: "7542CAB9AF2ACAAD", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}, {id: "11ED547FEB6FE9ED", type: "command", command: "/workplace unlock {p} aliveworkplace:guildhall", elevate_perms: true, silent: true}]
		},
		{
			id: "14B8E980F11B2C2B",
			x: 15.0d,
			y: 0.0d,
			title: "Found a guild",
			description: ["Build a Guildhall for your guild.", "", "The reward of the last quest (The Guild Charter) put it in your Blueprint Table.", "", "1. Right-click the Blueprint Table, pick the Guildhall and press Get Blueprint. It uses one Blank Blueprint (craft paper and blue dye to get two).", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of the Blueprint Table. The gold edge of the outline is the front.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint. They clear the spot and build it during the day.", "", "When it's finished the guild is founded, and from then on its members work faster.", "", "This quest completes by itself when the builder finishes the Guildhall."],
			dependencies: ["152E6CF8FF955275"],
			icon: {id: "minecraft:bell", count: 1},
			tasks: [{id: "6579792AFF522E00", type: "advancement", advancement: "aliveworkplace:built/guildhall", criterion: ""}],
			rewards: [{id: "579C2DA307143DD4", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}]
		},
		{
			id: "1002E8FA0776B281",
			x: 18.0d,
			y: 0.0d,
			title: "Proclaim an edict",
			description: ["Pass a law for your village: an edict.", "", "1. Open the Village Hall and click the lectern (Book of Edicts) at the left of the second row.", "2. Each edict shows its boost in green and its cost in red (Long Shifts, Free Bread, Curfew...).", "3. Click an edict twice to proclaim it.", "", "A Hamlet has room for one edict, a City for four.", "", "Click the checkmark above once you've proclaimed an edict."],
			dependencies: ["14B8E980F11B2C2B"],
			icon: {id: "minecraft:writable_book", count: 1},
			tasks: [{id: "4173341C9847FBE8", type: "checkmark", title: "I proclaimed an edict"}],
			rewards: [{id: "41460CFD6B56F63B", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "1BA03EED4AD56C78",
			x: 21.0d,
			y: 0.0d,
			title: "The Legends page",
			description: ["Find out which Legends your village could earn.", "", "Open the Village Hall and click the nether star (Legends) in the row of page buttons. Each card shows a Legend, how they come and what your village still needs for them.", "", "Legends are rare villagers with powers no other worker has.", "", "Click the checkmark above once you've opened the Legends page."],
			dependencies: ["1002E8FA0776B281"],
			icon: {id: "minecraft:nether_star", count: 1},
			tasks: [{id: "37EB3E3B84DC2325", type: "checkmark", title: "I opened the Legends page"}],
			rewards: [{id: "36082F06D5CAFCB1", type: "xp", xp: 50}]
		},
		{
			id: "433144F1B36D110D",
			x: 24.0d,
			y: 0.0d,
			title: "Your first Legend",
			description: ["Get a Legend to settle in your village.", "", "1. On the Legends page, pick a Legend whose needs your village can meet, and meet them. A card that says the village has all they need means they may come.", "2. They come on a visit, are found out in the world, are born, or rise from a Master's strange mood. A visitor stays up to three days: right-click them for what they want to stay.", "3. A settled Legend needs a home of their own in a tier III building, their luxury once a week and a happy village.", "", "A Legend is always a Master, with their name in gold over their head.", "", "Click the checkmark above once a Legend lives in your village."],
			dependencies: ["1BA03EED4AD56C78"],
			tasks: [{id: "71AF22A238A783D9", type: "checkmark", title: "A Legend lives in my village"}],
			rewards: [{id: "7845FF3F2E0DD2C4", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 10}, {id: "4C78FDDF8FECC0CF", type: "xp", xp: 300}]
		},
		{
			id: "39CFFC8EF5B3511D",
			x: 27.0d,
			y: 0.0d,
			shape: "gear",
			size: 1.5d,
			title: "Seven levels of research",
			description: ["Get 7 levels of research done.", "", "1. Keep your scholars stocked with paper, books and emeralds. Library II (a side quest) has room for a second scholar.", "2. Keep building: a City needs 35 villagers, 25 finished buildings and 7 levels of research.", "3. Open the Village Hall (right-click it) and hover over the name tag at the top left: the yellow line says what the next rank still needs. The number in brackets after \"research\" is how many levels are done.", "", "Every level is a bonus for the whole village.", "", "Click the checkmark above once the name tag shows 7 or more levels of research done."],
			dependencies: ["433144F1B36D110D"],
			icon: {id: "minecraft:book", count: 1},
			tasks: [{id: "4E59B832E82934B7", type: "checkmark", title: "My scholars finished 7 levels of research"}],
			rewards: [{id: "5028DF1AED2F8A18", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 16}, {id: "16C5D7432BD19B21", type: "xp", xp: 400}]
		},
		{
			id: "354D4600E7346336",
			x: 0.0d,
			y: -2.0d,
			optional: true,
			title: "The Arena",
			description: ["Build an Arena for Pokémon tournaments.", "", "1. Buy the Arena blueprint from an Expert Trainer Leader, for 20 emeralds: right-click them to see their trades.", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of your builder's Blueprint Table.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint.", "", "A finished Arena, in a village of Village rank or bigger, turns its festivals into a Festival Cup.", "", "This quest completes by itself when the builder finishes the Arena."],
			dependencies: ["763B30CC4AA2D061"],
			tasks: [{id: "5ADC351705E85C11", type: "advancement", advancement: "aliveworkplace:built/arena", criterion: ""}],
			rewards: [{id: "14C1E964E73D7349", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 6}]
		},
		{
			id: "725D408EFFBB86B3",
			x: 0.0d,
			y: -4.0d,
			optional: true,
			title: "The Festival Cup",
			description: ["Fight a bout in the Festival Cup.", "", "1. Open the Village Hall and click the gold block (Festival Cup) in the row of page buttons. Press Sign up.", "2. On Cup day, when your bout is called in chat, go inside the Arena and click I'm ready (or type /workplace cup ready) within 2 minutes.", "", "Win bouts for prize money, and your village holds the Cup.", "", "Click the checkmark above once you've fought a bout."],
			dependencies: ["354D4600E7346336"],
			tasks: [{id: "7839BE3E51DFDD2F", type: "checkmark", title: "I fought a bout in the Festival Cup"}],
			rewards: [{id: "7737F3E1A0A8861A", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 6}]
		},
		{
			id: "58EDFF7DA5FBC6AF",
			x: 0.0d,
			y: 2.0d,
			optional: true,
			title: "A friend in the village",
			description: ["Earn three hearts with a villager.", "", "1. Look at a villager from up to 6 blocks away: your hearts with them show at the bottom of the screen.", "2. Trade with them, do their requests and come to their festivals to earn more.", "", "Every named villager keeps a friendship with you, up to ten hearts.", "", "Click the checkmark above once a villager shows three hearts for you."],
			dependencies: ["763B30CC4AA2D061"],
			tasks: [{id: "430A504516B68332", type: "checkmark", title: "A villager likes me with three hearts"}],
			rewards: [{id: "151B3E06FE5007CF", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 2}]
		},
		{
			id: "213D63B0A59B9CE8",
			x: 3.0d,
			y: -2.0d,
			optional: true,
			title: "The Rally Banner",
			description: ["Make a Rally Banner to lead your guards.", "", "1. Craft any banner and an iron ingot together.", "2. Raise it and your guards follow you.", "", "A map and red dye make a Patrol Map: mark up to eight spots and sneak-right-click a guard with it to give them a route.", "", "This quest completes by itself as soon as you have a Rally Banner in your inventory."],
			dependencies: ["5F80C395E9618060"],
			icon: {id: "aliveworkplace:rally_banner", count: 1},
			tasks: [{id: "2A3A372E38F617FC", type: "item", item: {id: "aliveworkplace:rally_banner", count: 1}}],
			rewards: [{id: "639BD8B1130CAE0F", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "18F352D0794D8199",
			x: 6.0d,
			y: -2.0d,
			optional: true,
			title: "A Lookout Tower",
			description: ["Build a Lookout Tower: a stone tower with a lookout platform on top.", "", "1. Buy the Lookout Tower blueprint from a Journeyman Builder (level 3) for 12 emeralds: right-click them to see their trades.", "2. Hold the blueprint and right-click the ground where the front should go, within 48 blocks of your builder's Blueprint Table.", "3. Hold Shift over the blueprint to see what it needs. Put all of it in chests or barrels within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with the blueprint.", "", "A guard whose grindstone is within 24 blocks of it keeps watch at night and spots raiders the evening before they come, so you get a day's warning. Lookout Tower II has a grindstone of its own.", "", "This quest completes by itself when the builder finishes the Lookout Tower."],
			dependencies: ["7ED000369F90D1EA"],
			icon: {id: "minecraft:spyglass", count: 1},
			tasks: [{id: "12EF9E337AA9D59A", type: "advancement", advancement: "aliveworkplace:built/lookout_tower", criterion: ""}],
			rewards: [{id: "2D4C28EA60EA13CE", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "7F3FDDCC62CBA7B4",
			x: 9.0d,
			y: -2.0d,
			optional: true,
			title: "Hold the walls",
			description: ["Hold off a siege.", "", "A raid on a village with a finished wall or gate build becomes a siege: the gates shut and the raiders have to break in.", "", "1. Keep guards on the walkways: a guard throws down ladders within 2 blocks.", "2. Defend the gate until the raiders are dead or flee at dawn.", "", "Walls keep the fight away from your villagers' homes.", "", "Click the checkmark above once your village has held off a siege."],
			dependencies: ["6597AAE5BFDC3678"],
			tasks: [{id: "19D5E2E042350A45", type: "checkmark", title: "My village held off a siege"}],
			rewards: [{id: "13BC0C484F388624", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}]
		},
		{
			id: "28CD1EE7B6F354D7",
			x: 9.0d,
			y: -4.0d,
			optional: true,
			title: "Take the fight to them",
			description: ["Defeat 10 pillagers.", "", "1. Sneak-right-click a guard with a spyglass: they become a Scout and bring home a map to the raiders' camp.", "2. Raise your Rally Banner: three in four of your guards gather round you as a war party.", "3. Lead them to the camp. Break it and the village has 10 days of peace.", "", "Pillagers count anywhere: at their camps, outposts and raids.", "", "This quest completes by itself when you have defeated 10 pillagers."],
			dependencies: ["7F3FDDCC62CBA7B4"],
			tasks: [{id: "55DE27BB168B8E6C", type: "kill", entity: "minecraft:pillager", value: 10L}],
			rewards: [{id: "11B698FE117453D1", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 10}]
		},
		{
			id: "3EA37BCAE968E36F",
			x: 15.0d,
			y: -2.0d,
			optional: true,
			title: "A tonic",
			description: ["Give a builder a Builder's Tea.", "", "1. Your Chef makes Builder's Tea from a glass bottle, 2 sweet berries and sugar in the chests by their smoker, and keeps 4 there.", "2. Take one from those chests.", "3. Right-click a builder with it.", "", "A tonic makes a worker 25% faster for a whole day. Your Cleric makes tonics for other jobs.", "", "This quest completes by itself as soon as you have a Builder's Tea in your inventory."],
			dependencies: ["14B8E980F11B2C2B"],
			icon: {id: "aliveworkplace:builders_tea", count: 1},
			tasks: [{id: "15D639A33B2197EE", type: "item", item: {id: "aliveworkplace:builders_tea", count: 1}}],
			rewards: [{id: "7D4F4AB49ED0AA1E", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		},
		{
			id: "1C2AC2FDFD127C66",
			x: 18.0d,
			y: -2.0d,
			optional: true,
			title: "Reform an edict",
			description: ["Reform an edict, so its cost goes away for good.", "", "1. While an edict is in force, its reform shows up one step a day: a villager of the right trade asks you, or the step goes up on the hall's Quests page.", "2. Do each step: bring something, defeat monsters near the village, or win a battle.", "3. After the last step, fireworks go up over the hall.", "", "The edict keeps its boost and loses its cost, even if you lift it and proclaim it again.", "", "Click the checkmark above once an edict has been reformed."],
			dependencies: ["1002E8FA0776B281"],
			tasks: [{id: "234EDABE752051C9", type: "checkmark", title: "I reformed an edict"}],
			rewards: [{id: "1E5FBD059EDEC5FC", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}]
		},
		{
			id: "3C6C1D7D4E2734E1",
			x: 24.0d,
			y: -2.0d,
			optional: true,
			title: "The Master Architect",
			description: ["Get the Master Architect, the builders' Legend, to live in your village.", "", "1. Find his card on the Legends page (the nether star at the hall).", "2. He visits a Town's inn once it has buildings finished in 3 different styles. Only one village in the world can have him.", "3. Give him what his card asks so he settles.", "", "Every Wonder needs him.", "", "Click the checkmark above once the Master Architect lives in your village."],
			dependencies: ["433144F1B36D110D"],
			tasks: [{id: "1B890450D7059EAB", type: "checkmark", title: "The Master Architect lives in my village"}],
			rewards: [{id: "5E94AE0E4DC0697C", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 8}]
		},
		{
			id: "3CF1E50F22CF18E4",
			x: 27.0d,
			y: -2.0d,
			optional: true,
			title: "Library II",
			description: ["Add a study tower to your Library, with a lectern for a second scholar.", "", "1. The builder who finished your Library now sells the Library II blueprint. Right-click them to trade for it.", "2. Right-click the finished Library with it, without sneaking. The outline lines up exactly over the building.", "3. Hold Shift over the blueprint to see what it needs, and put it in chests within 8 blocks of the Blueprint Table.", "4. Right-click your Builder with it. They only build what's new.", "", "It gives your village room for a second Scholar.", "", "This quest completes by itself when the builder finishes the Library II."],
			dependencies: ["39CFFC8EF5B3511D"],
			tasks: [{id: "12140EDF50D45BE0", type: "advancement", advancement: "aliveworkplace:built/library_2", criterion: ""}],
			rewards: [{id: "6997EAD3F510FA0D", type: "item", item: {id: "minecraft:emerald", count: 1}, count: 3}]
		}
	],
